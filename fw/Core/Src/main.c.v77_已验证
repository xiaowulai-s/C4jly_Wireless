/* ==== 诊断实现(放在文件末尾, 避免与任何既有注释/结构冲突) ==== */
#if !HMI_DIAG
#define DIAG_N 10
static uint32_t s_dg_zw_n = 0;
static uint32_t s_dg_lo_n = 0;
static uint32_t s_dg_any = 0;           /* 收到的总字节数(含所有值) */
static uint32_t s_dg_asc = 0;           /* ASCII 可打印(0x20~0x7E): 疑环回(MCU 指令文本) */
static uint32_t s_dg_ff  = 0;           /* 0xFF: MCU 帧尾特征 */
static uint32_t s_dg_oth = 0;           /* 其他(非 1A/非 ASCII/非 FF) */
static uint32_t s_dg_dt[DIAG_N];
static uint32_t s_dg_dti = 0;
static uint32_t s_dg_last = 0;

void hmi_diag_any(uint8_t b)
{
  (void)b;
  s_dg_any++;
   /* 判据必须互斥(0xFF >= 0x1A, 原写法让 s_dg_ff 永远进不到) */
  if (b == 0xFFu)                s_dg_ff++;      /* MCU 帧尾 => 环回证据 */
  else if (b >= 0x20u && b <= 0x7Eu) s_dg_asc++;   /* 可打印 ASCII */
  else                            s_dg_oth++;
}

void hmi_diag_note(uint8_t b)
{
  uint32_t now = HAL_GetTick();
  if (b == 0x1A) {
    s_dg_zw_n++;
    if (s_dg_last) s_dg_dt[s_dg_dti++ % DIAG_N] = now - s_dg_last;
    s_dg_last = now;
  } else if (b == 0x1B) {
    s_dg_lo_n++;
  }
}

void hmi_diag_show(void)
{
  char s[64];
  int i, n;
  uint32_t idx;
  n = snprintf(s, sizeof(s), "E%lu F%lu O%lu Z%lu",
               (unsigned long)s_dg_asc, (unsigned long)s_dg_ff,
               (unsigned long)s_dg_oth, (unsigned long)s_dg_zw_n);
#if 0
    n = snprintf(s, sizeof(s), "A%lu Z%lu B%lu d=",
               (unsigned long)s_dg_any, (unsigned long)s_dg_zw_n, (unsigned long)s_dg_lo_n);
#endif
  {
    int base = n;               /* E/F/O/Z 部分长度, 供分隔符判断 */
    idx = s_dg_dti;
    for (i = (int)(DIAG_N - 4u); i < (int)DIAG_N; i++) {
    uint32_t v = s_dg_dt[(idx + i) % DIAG_N];
    if (!v) continue;
      if (n < (int)sizeof(s) - 10)
        n += snprintf(s + n, sizeof(s) - (size_t)n, "%s%lu", n > base ? "," : "", (unsigned long)v);
    }
    if (n == base) snprintf(s + n, sizeof(s) - (size_t)n, "-");
  }
  tjc_set_txt(OBJ_CAL_RS_F, s);
}
#endif
