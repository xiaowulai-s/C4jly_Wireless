/* ================= 标定 / 恢复出厂 / 清空历史 ================= 
 * fix12 变更:
 *   ① 屏幕回调只在 ISR 里置请求标志, 动作由主循环执行(避免中断内阻塞 flash 写与 HAL_Delay 死锁);
 *   ② 标定改两点式: 零点记下点 raw0 并立即点平; 量程用 raw0/raw1 联合解 k、b, 两点都精确且顺序无关;
 *   ③ 前置校验: 探头在线 + 开机满 CAL_WARM_MS;
 *   ④ 所有返回路径都写结果: 按钮 3 字短词 + 设置页右栏详细原因。
 * ============================================================= */

/* 标定失败原因 */
enum {
  CAL_E_OK = 0, CAL_E_OFFLINE, CAL_E_WARMUP, CAL_E_DIRTY,
  CAL_E_WINDOW, CAL_E_BADRAW, CAL_E_NOZERO, CAL_E_TOOCLOSE, CAL_E_KCLAMP,
  CAL_E_FLASH, CAL_E_CONFIRM, CAL_E_CHANGED,
  CAL_E_SENT,   /* 厂商指令已下发 */
  CAL_E_IDLE    /* 结果已展示完毕, 按钮恢复默认 */
};

/* 前置校验: 0=可标定, 否则返回失败原因 */
static uint8_t cal_precheck(void)
{
  if (!sensor_online()) return CAL_E_OFFLINE;
  if ((HAL_GetTick() - g_boot_ms) < CAL_WARM_MS) return CAL_E_WARMUP;
  return CAL_E_OK;
}

/* epoch 秒 -> 年/月/日 (civil_from_days) */
static void epoch_to_ymd(uint32_t e, int *py, int *pmo, int *pd)
{
  int z = (int)(e / 86400u) + 719468;
  int era = (z >= 0 ? z : z - 146096) / 146097;
  unsigned doe = (unsigned)(z - era * 146097);
  unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  unsigned doy = doe - (365u * yoe + yoe / 4u - yoe / 100u);
  unsigned mp = (5u * doy + 2u) / 153u;
  unsigned dd = doy - (153u * mp + 2u) / 5u + 1u;
  unsigned mm = (mp < 10u) ? (mp + 3u) : (mp - 9u);
  *py = (int)yoe + era * 400 + (mm <= 2u);
  *pmo = (int)mm;
  *pd = (int)dd;
}

#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Winvalid-source-encoding"    /* 源码为 GBK, 中文串必需; 字节已实证原样入 hex */

/* 结果上报: 按钮写短词, 设置页右栏写完整原因 */
static void cal_report(uint8_t which, uint8_t reason)
{
  char rs[64] = {0};    /* v34: 成功文案含补偿/灵敏度, 48 不够; 
                   * 显式清零: 任一 case 漏赋 rs 时, 末尾仍会推它,
                   *    栈上残留内容会显示成乱码文字 */
  const char *btn = (which == CAL_REQ_ZERO) ? OBJ_CAL0_BTN
                  : (which == CAL_REQ_SPAN) ? OBJ_CAL1_BTN
                  : (which == CAL_REQ_ZW)   ? OBJ_ZW_BTN
                  : (which == CAL_REQ_LO15) ? OBJ_LO15_BTN : OBJ_CAL_FAC_BTN;
   /* 详细原因行只在厂家页存在(crs_f); 其余页推 crs_s1 是死引用 */
  const char *rs_obj = (g_page_now == 5u) ? OBJ_CAL_RS_F : OBJ_CAL_RS;
  int push_rs = (g_page_now == 5u);
  const char *word;
  int k100 = (int)((PP.cal_k + 5) / 10);    /* v34: 千分斜率四舍五入到百分, 供量程成功文案 */

  switch (reason) {
    case CAL_E_OK:
      word = "执行";
      if (which == CAL_REQ_ZERO)      snprintf(rs, sizeof(rs), "零点标定完成 补偿%dppm，请确认环境洁净", (int)PP.cal_b);
      else if (which == CAL_REQ_SPAN) snprintf(rs, sizeof(rs), "量程标定完成 灵敏度 %d.%02d", k100 / 100, k100 % 100);
      else if (which == CAL_REQ_ZW)   snprintf(rs, sizeof(rs), "硬件零点指令已下发，请确认读数是否归零");
      else if (which == CAL_REQ_LO15) snprintf(rs, sizeof(rs), "15ppm 下限指令已下发，15 以内应显示 0");
      else                            snprintf(rs, sizeof(rs), "已恢复出厂设置，设备重启中");
      break;
     /* 指令已下发(无法从 MCU 侧确认传感器是否接受, 需人工核对读数) */
    case CAL_E_SENT:
      word = "已下发";
       /* 原先此分支不赋 rs[], 右栏会残留上一条"待确认"文案 */
      if (which == CAL_REQ_LO15)      snprintf(rs, sizeof(rs), "15ppm下限指令已下发，15以内将显示0；需核对读数");
      else                            snprintf(rs, sizeof(rs), "硬件零点指令已下发，请确认读数是否归零");
      break;

     /* 结果已展示, 按钮恢复各自己的默认文字。 
     *   cf(恢复出厂) 的屏端默认 txt 是「恢复」, 其余四个是「执行」——
     *   原先这里硬编码 "执行", 一旦给它挂上恢复计时就会写错字。*/
    case CAL_E_IDLE:
      if (which == CAL_REQ_FAC) { word = "恢复"; snprintf(rs, sizeof(rs), "可再次执行恢复出厂"); }
      else                     { word = "执行"; snprintf(rs, sizeof(rs), "可在洁净空气中再次标定"); }
      break;
    case CAL_E_OFFLINE:  word = "未接通"; snprintf(rs, sizeof(rs), "标定失败：探头未连接"); break;
    case CAL_E_WARMUP:   word = "预热中"; snprintf(rs, sizeof(rs), "标定失败：需开机 %u 秒后（示数稳定）", (unsigned)(CAL_WARM_MS / 1000u)); break;
    case CAL_E_DIRTY:    word = "浓度高"; snprintf(rs, sizeof(rs), "零点失败：当前超 %d ppm，需洁净空气", CAL_ZERO_MAX_PPM); break;
    case CAL_E_WINDOW:   word = "超窗口"; snprintf(rs, sizeof(rs), "量程失败：示数需在 %d~%d ppm",
                                                (int)(SENSOR_SPAN_PPM * (1.0f - CAL_SPAN_TOL)),
                                                (int)(SENSOR_SPAN_PPM * (1.0f + CAL_SPAN_TOL))); break;
    case CAL_E_BADRAW:   word = "非法值"; snprintf(rs, sizeof(rs), "标定失败：原始读数为 0，检查探头"); break;
    case CAL_E_NOZERO:   word = "无零点"; snprintf(rs, sizeof(rs), "量程失败：请先做零点标定"); break;
    case CAL_E_TOOCLOSE: word = "点太近"; snprintf(rs, sizeof(rs), "量程失败：与零点读数差不足 %d", CAL_MIN_SPAN_DELTA); break;
    case CAL_E_KCLAMP:   word = "已限幅"; snprintf(rs, sizeof(rs), "量程标定：斜率超范围已限幅"); break;
case CAL_E_FLASH:    word = "存储坏"; snprintf(rs, sizeof(rs), "失败：存储器故障，无法保存"); break;
    case CAL_E_CONFIRM:
      word = "待确认";
      if (which == CAL_REQ_FAC)        snprintf(rs, sizeof(rs), "将清空全部参数与历史记录（不可撤销），3秒内再按确认");
      else if (which == CAL_REQ_ZW)    snprintf(rs, sizeof(rs), "当前 %dppm，须洁净空气，3秒内再按确认", (int)g_cal0_ppm0);
      else if (which == CAL_REQ_LO15) snprintf(rs, sizeof(rs), "将下发 15ppm 下限指令（不可撤销），3秒内再按确认");
      else                            snprintf(rs, sizeof(rs), "当前 %dppm，须洁净空气，3秒内再按确认", (int)g_cal0_ppm0);
      break;
    case CAL_E_CHANGED:  word = "已作废"; snprintf(rs, sizeof(rs), "浓度已变化，请重新点击零点标定"); break;
    default:             word = "失败";   snprintf(rs, sizeof(rs), "标定失败"); break;
  }
  tjc_set_txt(btn, word);
  if (push_rs) tjc_set_txt(rs_obj, rs);

   /* 统一恢复计时(取代原先只在 CAL_E_SENT 两处手工置位的老做法)。 
   *   只要本次写入的按钮文案不是【该按钮的屏端默认 txt】, 就挂上延时恢复,
   *   由 cal_poll() 到点调 CAL_E_IDLE 复位 => 失败态/待确认/已下发全覆盖。
   *   CAL_E_IDLE 自身写的就是默认态, 故不会自我续期, 天然只触发一次。
   *   判据用 strcmp 而非指针比较: 同名 GBK 字面量是否被合并由编译器决定。*/
  if (reason == CAL_E_CONFIRM) {
    g_restore_btn[which] = CAL_REQ_NONE;    /* 待确认态由 cal_poll 的 armed 超时块负责, 不重复挂 */
    g_restore_t0 [which] = 0;
  } else if (reason == CAL_E_IDLE ||
             strcmp(word, (which == CAL_REQ_FAC) ? "恢复" : "执行") == 0) {
    g_restore_btn[which] = CAL_REQ_NONE;    /* 已是默认态, 无需恢复 */
    g_restore_t0 [which] = 0;
  } else {
     /* 同一次挂起只记一次时刻: 已挂起则不续期, 
     * 否则主循环里若反复上报同一失败原因会永远不到期。*/
    if (g_restore_btn[which] == CAL_REQ_NONE) g_restore_t0[which] = HAL_GetTick();
    g_restore_btn[which] = which;
  }
}

/* 标定状态上报(进设置页时): 未标定 / 日期 / 超期变橙 */
static void cal_upload_status(void)
{
   /* 标定状态/结果两行只存在于厂家设置页(cst_f/crs_f); 
   *   v9 起设置页已删除 cst_s1/crs_s1, 故非厂家页一律不上报(原先是死引用)。 */
  const char *obj_st;
  char s[56];       /* v34: 状态行追加补偿值, 40 不够 */
  uint32_t now, age;
  int yy, mo, dd;

  if (g_page_now != 5u) return;    /* 标定两行只在厂家页 */
  obj_st = OBJ_CAL_ST_F;

  if (!PP.cal_valid || PP.cal_ts == 0u) {    /* cal_valid 在此真正被读 */
    tjc_set_txt(obj_st, "标定：未标定");
    tjc_set_pco(obj_st, (uint32_t)C_CAL_NORMAL);
    return;
  }
  epoch_to_ymd(PP.cal_ts, &yy, &mo, &dd);
  now = rtc_wall_seconds();
  age = (now > PP.cal_ts) ? (now - PP.cal_ts) : 0u;
  if (age > CAL_EXPIRE_DAYS * 86400u) {
    snprintf(s, sizeof(s), "标定：%04d-%02d-%02d 已超期 补偿%dppm", yy, mo, dd, (int)PP.cal_b);
    tjc_set_pco(obj_st, (uint32_t)C_STRIP_ORANGE);
  } else {
    snprintf(s, sizeof(s), "标定：%04d-%02d-%02d 补偿%dppm", yy, mo, dd, (int)PP.cal_b);
    tjc_set_pco(obj_st, (uint32_t)C_CAL_NORMAL);
  }
  tjc_set_txt(obj_st, s);
}

