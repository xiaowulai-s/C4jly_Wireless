/* ==== 临时验证入口(已关闭 DEVTEST_OFF=1) ==== 
 *  第一步只加了 sensor_send_cmd(), 无人调用 => 编译出来无法验证指令。
 *  本段上电自动: 打印读数 -> 下发 15ppm 两条指令 -> 再打印读数。
 *  打印走 USART1(PA9/PA10, 115200, 空闲预留), 用 USB-TTL 接该口即可看到全部输出。
 * 已关闭(2026-10-12): 该入口上电 3 秒自动下发 15ppm 两条指令, 会污染验证。 */
#define DEVTEST_OFF 1    /* 已关闭: 该入口上电 3 秒后会自动下发 15ppm 两条指令, 
 *                                   会污染验证且每次上电重发。改回 0 可复现自动测试。 */

#if !DEVTEST_OFF
static volatile uint8_t s_devtest = 0;    /* 0=未开始 1=等首帧 2=已发指令1 3=已发指令2 4=完成 */
static uint32_t s_devtest_t0 = 0;
static void devtest_ppm(const char *tag)
{
  char b[48];
   /* sensor_read_raw() 返回浮点(如 850.5); +0.5 四舍五入后再取整, 
   *   避免 14.9 被截成 14 而误判「已截零」 */
  int r = (int)(sensor_read_raw() + 0.5f);
  int i = 0;
  const char *p = tag;
   /* 调试输出走 USART1(PA9/PA10, 115200, 本就初始化且全程空闲), 
   *   不用 USART3(屏) 以免混入屏指令流被屏误解析。 */
  while (*p && i < 20) b[i++] = *p++;
  b[i++] = (char)((r / 100) + 0x30);
  b[i++] = (char)(((r / 10) % 10) + 0x30);
  b[i++] = (char)((r % 10) + 0x30);
  b[i++] = 0x0D; b[i++] = 0x0A; b[i] = 0;
  HAL_UART_Transmit(&huart1, (uint8_t *)b, (uint16_t)i, 50);
}
#endif
