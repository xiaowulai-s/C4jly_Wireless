/* 零点标定(主循环): 洁净空气中记录下点 raw0, 并立即把零点点平 */
static void cal_do_zero(void)
{
  uint8_t e = cal_precheck();
  float ppm, raw, dt;

  if (e) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZERO, e); return; }
  ppm = sensor_read_ppm();
  if (ppm >= (float)CAL_ZERO_MAX_PPM) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZERO, CAL_E_DIRTY); return; }

   /* 两步确认: 第一次点击只回报当前浓度(便于判断是否洁净), 不写 Flash; 
   *   窗口 CAL_ZERO_CONFIRM_MS 内第二次点击才真正标定; 窗口内浓度变化超过
   *   CAL_ZERO_STABLE_PPM 视为环境已变 -> 本次作废, 需重新从第一次点击开始。 */
  if (CAL0_ARMED_BY(CAL_REQ_ZERO) && (HAL_GetTick() - g_cal0_t0) <= CAL_ZERO_CONFIRM_MS) {
    dt = ppm - g_cal0_ppm0;
    if (dt < 0.0f) dt = -dt;
    if (dt > CAL_ZERO_STABLE_PPM) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZERO, CAL_E_CHANGED); return; }
    g_cal0_armed = 0;
  } else {
     /* 归属标记: 若 armed 属于别的操作, 先作废再重新 arm */
    if (g_cal0_armed) g_cal0_armed = 0;
    g_cal0_armed = 1; g_cal0_owner = CAL_REQ_ZERO;
    g_cal0_t0 = HAL_GetTick(); g_cal0_ppm0 = ppm;
    cal_report(CAL_REQ_ZERO, CAL_E_CONFIRM);
    return;
  }

   /* 删掉原 if (raw <= 0.0f) -> CAL_E_BADRAW 判据 (P0-B): 
   *   sensor_read_raw() 直接返回传感器原始浓度(无 0 保护), 而【洁净空气中原始读数就是 0】
   *   => 在真洁净环境做零点标定会误报「原始读数为 0，检查探头」而失败,
   *      恰好与 v49「引导用户在洁净环境标定」的目的冲突。
   *   该判据本意是防「探头没出数」, 但 cal_precheck() 已检查 sensor_online(), 属冗余。
   *   仍保留 raw < 0 的防护(负值不可能, 但防止 cast到 int32 后异常)。*/
  raw = sensor_read_raw();
  if (raw < 0.0f) { cal_report(CAL_REQ_ZERO, CAL_E_BADRAW); return; }

  PP.cal_raw0  = (int32_t)raw;                                     /* 两点标定的下点 */
  PP.cal_b     = -(int32_t)((raw * (float)PP.cal_k) / 1000.0f);    /* 立即点平 */
  PP.cal_ts    = rtc_wall_seconds();
  PP.cal_valid = 1;
  param_save_safe();
  sensor_set_cal(PP.cal_k, PP.cal_b);
  g_cal_st_dirty = 1;    /* 标定状态行实时刷新: 不必切页回来才看到新日期/新补偿 */
  cal_report(CAL_REQ_ZERO, CAL_E_OK);
}

/* 量程标定(主循环): 通入 SENSOR_SPAN_PPM 标定气, 用 raw0/raw1 两点联合解 k、b 
 *   ppm(raw0)=0, ppm(raw1)=SENSOR_SPAN_PPM  =>  k = span*1000/(raw1-raw0), b = -raw0*k/1000 */
static void cal_do_span(void)
{
  uint8_t e = cal_precheck();
  int32_t raw0;
  float ppm, raw1, lo, hi;
  int64_t k, b;

  g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE;    /* v49: 换操作即作废未完成的零点确认(须在 precheck 之前, 失败路径也要清) */
  if (e) { cal_report(CAL_REQ_SPAN, e); return; }
  raw0 = PP.cal_raw0;
  if (raw0 == (int32_t)PARAM_RAW0_NONE) { cal_report(CAL_REQ_SPAN, CAL_E_NOZERO); return; }

  ppm = sensor_read_ppm();
  lo  = SENSOR_SPAN_PPM * (1.0f - CAL_SPAN_TOL);
  hi  = SENSOR_SPAN_PPM * (1.0f + CAL_SPAN_TOL);
  if (ppm < lo || ppm > hi) { cal_report(CAL_REQ_SPAN, CAL_E_WINDOW); return; }

  raw1 = sensor_read_raw();
   /* raw1 为 1000ppm 标气读数, 恒 >0; 保留判据仅作防御 */
  if (raw1 <= 0.0f) { cal_report(CAL_REQ_SPAN, CAL_E_BADRAW); return; }
  if (((int32_t)raw1 - raw0) < CAL_MIN_SPAN_DELTA) { cal_report(CAL_REQ_SPAN, CAL_E_TOOCLOSE); return; }

  k = ((int64_t)SENSOR_SPAN_PPM * 1000) / ((int64_t)raw1 - (int64_t)raw0);
  b = -((int64_t)raw0 * k) / 1000;
  e = CAL_E_OK;
  if (k < SENSOR_CAL_K_MIN) { k = SENSOR_CAL_K_MIN; e = CAL_E_KCLAMP; }
  if (k > SENSOR_CAL_K_MAX) { k = SENSOR_CAL_K_MAX; e = CAL_E_KCLAMP; }

  PP.cal_k     = (int32_t)k;
  PP.cal_b     = (int32_t)b;
  PP.cal_ts    = rtc_wall_seconds();
  PP.cal_valid = 1;
  param_save_safe();
  sensor_set_cal(PP.cal_k, PP.cal_b);
  g_cal_st_dirty = 1;    /* 同上, 量程标定后实时刷新 cst_f */
  cal_report(CAL_REQ_SPAN, e);
}

/* ---- 硬件零点校准: 向 UART4 下发厂商指令 ---- 
 * 防护: 固件侧两步确认(3 秒窗口内再按一次 + 浓度变化超限作废),
 * 且当前浓度必须低于 CAL_ZERO_MAX_PPM。屏端为普通短按, 与 c0/c1 同构。
 该指令把传感器内部零点归零, 【有被测气体时执行会导致读数异常】, 防护不可省。 */
static void cal_do_zero_hw(void)
{
  uint8_t e = cal_precheck();
  float ppm, dt;

  if (e) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZW, e); return; }
  ppm = sensor_read_ppm();
  if (ppm >= (float)CAL_ZERO_MAX_PPM) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZW, CAL_E_DIRTY); return; }

   /* 两步确认: 第一次只回报当前浓度, 窗口内第二次才真正下发指令 */
  if (CAL0_ARMED_BY(CAL_REQ_ZW) && (HAL_GetTick() - g_cal0_t0) <= CAL_ZERO_CONFIRM_MS) {
    dt = ppm - g_cal0_ppm0;
    if (dt < 0.0f) dt = -dt;
    if (dt > CAL_ZERO_STABLE_PPM) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_ZW, CAL_E_CHANGED); return; }
    g_cal0_armed = 0;
  } else {
     /* 归属标记: 若 armed 属于别的操作, 先作废再重新 arm */
    if (g_cal0_armed) g_cal0_armed = 0;
    g_cal0_armed = 1; g_cal0_owner = CAL_REQ_ZW;
    g_cal0_t0 = HAL_GetTick(); g_cal0_ppm0 = ppm;
    cal_report(CAL_REQ_ZW, CAL_E_CONFIRM);
    return;
  }

  sensor_send_cmd(SENSOR_CMD_ZERO_HW, SENSOR_CMD_ZERO_HW_LEN);
  cal_report(CAL_REQ_ZW, CAL_E_SENT);
}

/* ---- 15ppm 下限: 依次下发两条厂商指令, 之后传感器侧 0~15ppm 截零 ---- 
 * 同样走两步确认。两条指令必须按序下发, 缺一无效。 */
static void cal_do_lo15(void)
{
  uint8_t e = cal_precheck();
  float ppm, dt;

  if (e) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_LO15, e); return; }
  ppm = sensor_read_ppm();

  if (CAL0_ARMED_BY(CAL_REQ_LO15) && (HAL_GetTick() - g_cal0_t0) <= CAL_ZERO_CONFIRM_MS) {
    dt = ppm - g_cal0_ppm0;
    if (dt < 0.0f) dt = -dt;
    if (dt > CAL_ZERO_STABLE_PPM) { g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE; cal_report(CAL_REQ_LO15, CAL_E_CHANGED); return; }
    g_cal0_armed = 0;
  } else {
     /* 归属标记: 若 armed 属于别的操作, 先作废再重新 arm */
    if (g_cal0_armed) g_cal0_armed = 0;
    g_cal0_armed = 1; g_cal0_owner = CAL_REQ_LO15;
    g_cal0_t0 = HAL_GetTick(); g_cal0_ppm0 = ppm;
    cal_report(CAL_REQ_LO15, CAL_E_CONFIRM);
    return;
  }

  sensor_send_cmd(SENSOR_CMD_LO15_A, SENSOR_CMD_LO15_LEN);
  HAL_Delay(50);                       /* 两条指令间留间隔, 传感器需时间解析 */
  sensor_send_cmd(SENSOR_CMD_LO15_B, SENSOR_CMD_LO15_LEN);
  cal_report(CAL_REQ_LO15, CAL_E_SENT);
}

/* 恢复出厂(主循环): 只重置参数, 不动历史记录 */
static void cal_do_factory(void)
{
   /* 恢复出厂的两段确认从屏端搬到固件。 
   *   原因: 原屏端用 cft/cfs 变量做两段, 中途放弃就永久停在「确认」,
   *   固件完全管不到(屏端状态)。v65 屏包已把 cf 改为单发 D5/5A/17,
   *   由这里统一 arm / 超时 / 下发, 与其余四个按钮同一套机制。
   *   原开头的强制清 armed 必须删掉, 否则永远无法进入等待确认态。*/
  if (CAL0_ARMED_BY(CAL_REQ_FAC) && (HAL_GetTick() - g_cal0_t0) <= CAL_ZERO_CONFIRM_MS) {
    g_cal0_armed = 0; g_cal0_owner = CAL_REQ_NONE;
  } else {
    if (g_cal0_armed) g_cal0_armed = 0;    /* armed 属于别的操作: 作废后重新 arm */
    g_cal0_armed = 1; g_cal0_owner = CAL_REQ_FAC;
    g_cal0_t0 = HAL_GetTick();
    cal_report(CAL_REQ_FAC, CAL_E_CONFIRM);
    return;
  }
  if (!g_selftest.flash_ok) { cal_report(CAL_REQ_FAC, CAL_E_FLASH); return; }    /* T-15: Flash 故障禁写 */
  param_factory(&PP, 1);                  /* 保留 hist_base -> 不撤销"清空历史" */
  g_thr_hi = PP.thr_hi; g_thr_lo = PP.thr_lo;
  sensor_set_cal(PP.cal_k, PP.cal_b);
  app_apply_threshold();
  cal_report(CAL_REQ_FAC, CAL_E_OK);
  HAL_Delay(200);                         /* 主循环上下文, 让屏显示完再复位 */
  NVIC_SystemReset();
}

/* 主循环: 消费标定请求 */
static void cal_poll(void)
{

   /* 结果展示计时: 到点把按钮恢复默认, 右栏换成可再次标定的提示 */
   /* 遍历全部操作, 各???独立计时。 
   *   必须先把该格清掉再调 cal_report —— cal_report 末尾会写同一格,
   *   若先调后清, 恢复动作会被随后的清零抹掉, 按钮又停在旧文案。*/
  {
    uint32_t now = HAL_GetTick();
    uint8_t  w;
    for (w = 1u; w < CAL_REQ_COUNT; w++) {       /* 0=NONE 无按钮 */
      if (g_restore_btn[w] == CAL_REQ_NONE) continue;
      if ((now - g_restore_t0[w]) < CAL_RESULT_HOLD_MS) continue;
      g_restore_btn[w] = CAL_REQ_NONE;
      g_restore_t0 [w] = 0;
      cal_report(w, CAL_E_IDLE);
    }
  }

   /* 待确认超时自动解锁(根治「按多少次都是待确认」)。 
   *   病根: g_cal0_armed 置 1 后无人清, 第二次点击若已超窗口, 走 else 分支
   *   【重新 arm】又报「待确认」=> 按钮永远停在「待确认」, 走不到下发。
   *   这里到点强制清 armed/owner 并把按钮恢复默认; 顺带清掉 g_cal0_ppm0
   *   防止陈旧读数残留在文案里。
   *   注意: 与上面恢复计时块互不冲突 —— 本块只在 armed 态才做事, 而结果态
   *   路径都会清 armed。窗口内正常第二次点击时本块不触发(时间未到)。*/
  if (g_cal0_armed && (HAL_GetTick() - g_cal0_t0) > CAL_ZERO_CONFIRM_MS) {
    uint8_t ow = g_cal0_owner;
    g_cal0_armed  = 0;
    g_cal0_owner  = CAL_REQ_NONE;
    g_cal0_ppm0   = 0.0f;
    cal_report(ow, CAL_E_IDLE);
  }
  uint8_t r = g_cal_req;

  if (g_cal_st_dirty) { g_cal_st_dirty = 0; cal_upload_status(); }
  if (!r) return;
  g_cal_req = CAL_REQ_NONE;
  if (r == CAL_REQ_ZERO)      cal_do_zero();
  else if (r == CAL_REQ_SPAN) cal_do_span();
  else if (r == CAL_REQ_FAC)  cal_do_factory();
  else if (r == CAL_REQ_ZW)   cal_do_zero_hw();
  else if (r == CAL_REQ_LO15) cal_do_lo15();
}

/* 主循环: 消费"清空历史"请求 */
static void hist_clear_poll(void)
{
  if (!g_hist_clear_req) return;
  g_hist_clear_req = 0;
  if (g_selftest.flash_ok) {
    history_clear();
     /* P0-A 修复: 同步 PP.hist_base —— 三次排查确认的【数据损坏路径】。 
     *   缺陷: history_clear() 只推进 history.c 内部的静态 g_hist_base, 而落盘走
     *     param_set_hist_base(),后者用【局部 param_t t】写 flash
     *     => 全局 PP.hist_base 从头到尾没被更新。
     *   而 param_init(&PP) 只在开机执行一次(main.c:428), 之后 param_save_safe()
     *     一律 param_save(&PP) => 把开机时的旧 hist_base 连同新阈值写进新槽,
     *     【覆盖掉刚写入的清空标记】。
     *   后果链: 下次开机 history_init() 算出的 gen = maxhead - hist_base 少 1
     *     => ps = gen % HIST_SECTORS 指向错误扇区(真实数据在扇区0, 去读扇区1)
     *     => 读到全 0xFF 空扇区 => g_written 虚高(真实50条会显示成682条)
     *     => 后续 history_log() 触发 history.c 的整扇区擦除, 【逐步擦掉真实历史数据】。
     *   触发: 清空历史 -> 任意改一次阈值/标定 -> 重新上电(三步, 无需掉电)。
     *   加重因素(复核时发现): main.c 恢复出厂走 param_factory(&PP,1),
     *     而它 uint32_t hb = p->hist_base 保留的正是这个陈旧值
     *     => 恢复出厂不但不修正, 反而把错位【固化】。本行同步后该路径一并修好。 */
    PP.hist_base = history_get_base();
  }
  if (!g_page_init) { g_tbl_page = 1; refill_table(); }
}

