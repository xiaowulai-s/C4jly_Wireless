/* ---------- app_refresh: 周期刷新 ---------- */
/* 顶栏状态下发: 固件只写屏端全局变量, 由各页 load 事件读变量刷自己的控件
 * (照搬 thr 模式, 见协议头 SCREEN_VAR_THR)。变量赋值不依赖控件是否已建好,
 * 而 load 在页面建完之后执行 => 竞态从根上不存在, 切页不再闪默认值。
 * 另有一层兜底: 进页那一轮额外直写控件一次(见下方 direct 分支) —— load 只跑一次,
 * 变量若晚于 load 补发进去, 屏端就永远读不到真值。
 *
 * 变量契约(屏端 Program.s 声明 vp0~vp4, 每个变量只承载一种语义):
 *   vp0 = 探头 1/0         -> 屏端 if 刷 pc0d*.pic 与 pc0*.txt
 *   vp1 = 泵   1/0         -> 屏端 if 刷 pc1d*.pic 与 pc1*.txt
 *   vp2 = 电量圆点图片ID   -> 屏端 pc2d*.pic=vp2
 *   vp3 = 顶栏色条背景色   -> 屏端 dvr*.bco=vp3
 *   vp4 = 电量百分比 0~100 -> 屏端 cov vp4,pc2*.txt,0 出电量文字
 * 切勿拿 vp2 去 cov 出文字: vp2 是图片ID(5/3/6), cov 出来是无意义数字。
 */
static void hmi_update_status_chips(uint8_t full) {
  static uint8_t s_dot = 0xFFu, s_pump = 0xFFu, s_bat = 0xFFu;   /* 镜像缓存(0xFF=未发过) */
  static uint32_t s_strip = 0xFFFFFFFFu;    /* 顶栏报警色条档位缓存 */
  static int      s_pct  = -1;             /* 电量百分比缓存 */
  /* 色条上一轮下发值: 独立于 s_strip(后者是"变量要不要写"的缓存),
   * 而色条必须每次报警等级变化都直写控件 —— 稳态无 load 可依赖。*/
  static uint32_t s_strip_prev = 0xFFFFFFFFu;    /* 0xFFFFFFFF=从未下发, 强制首轮发 */
  /* 三个圆点上一轮【直写控件】的值: 与上面的 s_dot/s_pump/s_bat(变量缓存)分开,
   * 因为圆点也必须「值一变就直写」, 不能只靠进页那一轮 —— 同色条 s_strip_prev 之理。
   * 0xFF = 从未直写, 强制首轮发。*/
  static uint8_t s_dot_prev = 0xFFu, s_pump_prev = 0xFFu, s_bat_prev = 0xFFu;
  int probe = sensor_online();
  int pct   = battery_get_pct();
  int st_ok = g_selftest.flash_ok;    /* 探头可用的前置外设自检 */
  uint8_t dot  = (probe && st_ok) ? 1u : 0u;
  uint8_t pump = pump_get() ? 1u : 0u;
  uint8_t bpic = (pct >= BAT_DOT_WARN_PCT) ? (uint8_t)PIC_DOT_GREEN
               : (pct >= BAT_DOT_LOW_PCT)  ? (uint8_t)PIC_DOT_AMBER : (uint8_t)PIC_DOT_RED;
   /* 顶栏报警色条档位(屏端 load 事件负责上色, 这里只把档位写进变量) */
  uint32_t stc = (g_alarm >= 2) ? (uint32_t)C_STRIP_RED
               : (g_alarm == 1) ? (uint32_t)C_STRIP_ORANGE : (uint32_t)C_STRIP_IDLE;    /* 顶栏色带: 正常态保持屏端原色 */
  /* 上电补偿窗口: 屏冷启动需 1~3s, 固件上电首轮发的变量指令会被屏端吞掉,
   * 而 L1 门控此时已把变量记成"已发送" => 屏端 load 永远读到初值 0
   * => 初始化页三个圆点一直停在灰色。故前 3 秒内无条件重发变量。*/
  int boot_resend = ((HAL_GetTick() - g_boot_ms) < 3000u);
  /* 进页放行后的第一轮: 除写变量外额外直写控件一次。屏端 load 只在进页跑一次,
   * 变量若晚于 load 补发进去就永远读不到真值, 且 L1 门控不重试 => 状态永久卡住。
   * 此刻屏障已等过、对象已建好, 直写不会撞进重建窗口, 故不引入闪烁。*/
  int direct = g_page_entry;
  g_page_entry = 0;
  if (!boot_resend && !direct && !g_full_dirty && !full
      && dot == s_dot && pump == s_pump && bpic == s_bat && stc == s_strip && pct == s_pct) return;
  s_dot = dot; s_pump = pump; s_bat = bpic; s_strip = stc; s_pct = pct;
  /* 写 5 个变量(供屏端各页 load 自刷) */
  tjc_set_var(SCREEN_VAR_PROBE, dot  ? 1 : 0);
  tjc_set_var(SCREEN_VAR_PUMP,  pump ? 1 : 0);
  tjc_set_var(SCREEN_VAR_BPIC,  bpic);
  tjc_set_var(SCREEN_VAR_STRIP, (int)stc);
  tjc_set_var(SCREEN_VAR_BPCT,  pct);    /* 屏端 cov 用它出电量数字 */
  /* 进页这一轮额外直写控件: 不依赖屏端 load 是否已读过。
   * 电量【文字】故意不在此直写: 屏端 cov vp4 只出裸数字, 与完整文案「电量 N%」
   * 冲突 -> 会先闪 0 / 裸数字再被 tjc_set_bat 覆盖。文字由 tjc_set_bat 独家负责。*/
  /* 不按 g_page_now 选名, 5 页全推 —— 屏端出页可能不发通知
   * (厂家页返回键只 page 2 不 printh 4x), g_page_now 会停在 5,
   * 按页选名就会把值推到用户早已离开的页上。*/
  static const char *const sfx_all[5] = { "", "_s1", "_s2", "_i", "_f" };
  char n[12];
  unsigned k;
  /* 三个圆点: 任一值变化就直写 5 页全部副本, 不受 direct 门控 ——
   * 与色条同理: 屏端 load 只在进页跑一次, 只写变量的话, 屏上永远是进页那一刻的值。
   * 真机症状: 初始化页电量 31% 显示红点, 主页显示橙点(31% 应为琥珀色)。*/
  if (direct || dot != s_dot_prev || pump != s_pump_prev || bpic != s_bat_prev) {
    s_dot_prev = dot; s_pump_prev = pump; s_bat_prev = bpic;
    for (k = 0; k < 5; k++) {
      snprintf(n, sizeof(n), "pc0d%s", sfx_all[k]); tjc_pic(n, dot ? PIC_DOT_GREEN : PIC_DOT_GRAY);
      snprintf(n, sizeof(n), "pc1d%s", sfx_all[k]); tjc_pic(n, pump ? PIC_DOT_GREEN : PIC_DOT_GRAY);
      snprintf(n, sizeof(n), "pc2d%s", sfx_all[k]); tjc_pic(n, bpic);
    }
  }
  if (direct) {
    for (k = 0; k < 5; k++) {
      snprintf(n, sizeof(n), "pc0%s",  sfx_all[k]);
      tjc_set_txt(n, probe ? "\xCC\xBD\xCD\xB7 \xD2\xD1\xC1\xAC\xBD\xD3" : "\xCC\xBD\xCD\xB7 \xCE\xB4\xC1\xAC\xBD\xD3");
      snprintf(n, sizeof(n), "pc1%s",  sfx_all[k]);
      tjc_set_txt(n, pump ? "\xB1\xC3 \xD2\xD1\xC6\xF4\xB6\xAF" : "\xB1\xC3 \xCE\xB4\xC6\xF4\xB6\xAF");
    }
  }
  /* 色条单独处理: 每次报警等级变化都要直写 4 个 dvr, 不放在上面的 direct 门控内。
   * 色条与圆点性质不同: 它是会反复升/降的连续量, 而 load 只跑一次,
   * 只靠进页那一次 => 稳态报警变化只写了变量没人读, 色条永远停在进页时的颜色
   * (表现为"报警不变色"与"解除后主页不恢复")。
   * 解除时必须显式写回 C_STRIP_IDLE, 否则残留红色。*/
  if (direct || stc != s_strip_prev) {
    s_strip_prev = stc;
    /* 厂家页色条对象名无 _f 后缀(实测屏包) */
    tjc_set_bco("dvr",    stc);    /* 主页 + 厂家页(同名 dvr) */
    tjc_set_bco("dvr_s1", stc);
    tjc_set_bco("dvr_s2", stc);
    tjc_set_bco("dvr_i",  stc);
  }
}

/* 预热倒计时: 独立高频驱动(初始化页 pt0_i), 文案 "剩余 N 秒" 
 *   从 hmi_update_status_chips 抽出: 后者搭 app_refresh 的车, 而 app_refresh 每轮
 *   阻塞发 567B(9600bps 约 0.59s), 每 2s 的 refill_table 更要多发 1749B(约 1.82s),
 *   把轮次撑到 2.66s -> 倒计时看着像"每 3 秒跳一次"。改为主循环每轮紧邻调用,
 *   且仅在初始化页工作, 让秒值变化能第一时间发出。
 *   用无符号差算 elapsed: 天然抗 HAL_GetTick 回绕, 且先夹紧再换算, 避免下溢。 */
static void hmi_update_init_countdown(void) {
  static int last_left = -1;
  uint32_t el;
  int left;
  char cb[24];
  if (!g_page_init) { last_left = -1; return; }    /* 非初始化页: 复位, 便于下次上电重发 */
  el = HAL_GetTick() - g_boot_ms;
  left = (el >= BOOT_INIT_MS) ? 0 : (int)((BOOT_INIT_MS - el) / 1000u);
  if (left == last_left) return;                   /* 仅整秒变化时下发, 省串口带宽 */
  last_left = left;
  snprintf(cb, sizeof(cb), "\xCA\xA3\xD3\xE0 %d \xC3\xEB", left);
  tjc_set_txt(OBJ_INIT_CNT, cb);
}

/* 参数保存安全包装 (T-15/D3): Flash 自检失败时静默跳过, 防止向故障器件反复写入 */
static void param_save_safe(void) {
  if (!g_selftest.flash_ok) return;
  param_save(&PP);
}

/* POST 结果行 (T-15/D3): 初始化页 pst_i 常显自检结果 —— 全过绿色"自检通过", 失败红色故障文案。 
 * 注意: batt_ok 的语义是「电池采样链路是否有效」, **不是「电池是否在位」**:
 *   采样点在 BAT_SW(电池开关之后)。电池不在位但插着充电器时, 充电器经 D2(SS34) 单向
 *   灌入 BATTERY 节点 => BAT_SW 被充到 ~16.35V => ADC 读数有效 => 仍报「自检通过」。
 *   要真正检测"电池在位"需硬件(电池座检测脚, 或再采一路 CHG_IN 作对比), 当前不具备。
 * 只判固件可自证的静态外设(flash/电池); 探头为动态外设, 故障已由圆点+pc0 文案承载。
 * L1 风格: 结果不变不重发, 每次上电仅一轮(文本+颜色各 1 条)。 */
static void hmi_update_selftest(void) {
  static uint8_t s_fail = 0xFF, s_rst = 0xFF;
  uint8_t fail = (!g_selftest.flash_ok ? 1u : 0u) | (!g_selftest.batt_ok ? 2u : 0u);
   /* P0-B: 参数区曾失效(掉电落在 102 槽写满后的擦除窗口) => 参数已是出厂默认值, 
   *   而操作者可能毫不知情(阈值悄悄回到 500/100、标定回到 1000/0 => 浓度失准)。
   *   本项目的取舍是「参数可弃, 恢复出厂后重设即可」, 故**不做备份区**, 改为保证丢失可见。
   *   该标志由 param_reset_flag() 读取, 用户重设参数(param_save)后自动清除。 */
  uint8_t rst = param_reset_flag();
  char cb[48];
  if (!g_page_init) { s_fail = 0xFF; return; }    /* 出页复位, 下次上电重推 */
  if (fail == s_fail && rst == s_rst) return;
  s_fail = fail; s_rst = rst;
  if (fail == 0 && rst) snprintf(cb, sizeof(cb), "\xB2\xCE\xCA\xFD\xD2\xD1\xD6\xD8\xD6\xC3\xA3\xAC\xC7\xEB\xD6\xD8\xD0\xC2\xC9\xE8\xD6\xC3\xE3\xD0\xD6\xB5");    /* 参数已重置，请重新设置阈值 */
  else if (fail == 0) snprintf(cb, sizeof(cb), "\xD7\xD4\xBC\xEC\xCD\xA8\xB9\xFD");                 /* 自检通过 */
  else if (fail == 1) snprintf(cb, sizeof(cb), "\xB4\xE6\xB4\xA2\xC6\xF7\xB9\xCA\xD5\xCF");        /* 存储器故障 */
  else if (fail == 2) snprintf(cb, sizeof(cb), "\xB5\xE7\xB3\xD8\xB2\xC9\xD1\xF9\xD2\xEC\xB3\xA3");   /* 电池采样异常 */
  else                snprintf(cb, sizeof(cb), "\xB4\xE6\xB4\xA2\xC6\xF7/\xB5\xE7\xB3\xD8\xB9\xCA\xD5\xCF");  /* 存储器/电池故障 */
  tjc_set_txt(OBJ_SELFTEST_I, cb);
   /* 颜色: 故障红 / 参数已重置橙(警告非故障) / 全过绿 */
  tjc_set_pco(OBJ_SELFTEST_I, fail ? C_STRIP_RED : (rst ? C_STRIP_ORANGE : C_STRIP_GREEN));
}

/* 低电三级提示 (T-09/D5 主体, 2026-09-28): lb 文案+色 / 音效 id=5 通道1. 
 * 新电平需持续 1s 才生效(防负载瞬间跌落误判); 升级即播一次, 2 级 30s / 3 级 10s 重播.
 * 无自动断电(EN 未接 MCU): 3 级 = 持续催促直到电池耗尽(硬件补 EN 线后可升级真关机). */
/* 低电三级提示 (T-09): 按页下发 lb / lb_s1 / lb_s2 / lb_i 
 * 真机根因(2026-10-08): ① 屏端切页会按【页面初值】重绘控件, 而 lb 初值是空串;
 *   本函数原先在 lv 未变化时只重播音效、【不重发文案】, 且无 g_full_dirty 穿透
 *   => 切页后永久空白(同族缺陷第 4 例: 凡"进页需重绘"的推送都必须有 full 参与判据)。
 * ② 原先只发主页 lb, 初始化页/设置页/历史页收不到(屏端静默忽略); 音效 play 是
 *   全局指令故仍能听到 -> 造成"有声无字"的错觉。
 */
static void low_batt_poll(void) {
  static uint8_t s_lv = 0xFF, s_pend = 0xFF;
  static uint32_t s_pend_t = 0, s_last_play = 0;
  uint8_t lv = battery_get_level();
  char n[16];
  char cb[32];
  uint8_t page_full;

  if (lv != s_pend) { s_pend = lv; s_pend_t = HAL_GetTick(); return; }    /* 新电平需稳定 1s */
  if (HAL_GetTick() - s_pend_t < 1000u) return;

   /* 进页/上电本轮强制重发(full 期间不重播音效, 避免一进页就响) */
  page_full = g_full_dirty ? 1u : 0u;

  if ((lv == s_lv) && !page_full) {
    if ((lv == 2 && HAL_GetTick() - s_last_play >= 30000u) ||
        (lv == 3 && HAL_GetTick() - s_last_play >= 10000u)) {
      s_last_play = HAL_GetTick();
      tjc_lowbatt_play();
    }
    return;
  }
  s_last_play = HAL_GetTick();    /* 本轮已处理(含 full 重发): 刷新静音计时, 避免紧接着又播 */
  s_lv = lv;

   /* 不再按 g_page_now 选名, 改为 5 页全推 —— 与 tjc_set_bat 同一理由: 
   *   屏端「出页」可能不发通知(实测厂家页返回键 bk 只发 page 2 不发 printh 4x),
   *   固件 g_page_now 会与屏端实际页不同步, 按页选名就会推错对象。
   *   低电提示只在【电平变化】或 full 时发(本函数上方的 L1 判定已门控),
   *   5 页全推的串口代价可忽略。*/
  {
    static const char *const sfx_all[5] = { "", "_s1", "_s2", "_i", "_f" };
    unsigned k;
    for (k = 0; k < 5; k++) {
      snprintf(n, sizeof(n), "lb%s", sfx_all[k]);
      if (lv == 0) {
        tjc_set_txt(n, "");                           /* 空串(与页面初值一致) */
        tjc_set_pco(n, 57149u);                       /* 复位文字色 */
      } else {
        if (lv == 1) snprintf(cb, sizeof(cb), "\xB5\xE7\xC1\xBF\xB5\xCD\xA3\xAC\xC7\xEB\xB3\xE4\xB5\xE7");  /* 电量低，请充电 */
        else if (lv == 2) snprintf(cb, sizeof(cb), "\xB5\xE7\xC1\xBF\xBC\xB4\xBD\xAB\xBA\xC4\xBE\xA1");  /* 电量即将耗尽 */
        else              snprintf(cb, sizeof(cb), "\xB5\xE7\xC1\xBF\xBD\xAB\xBA\xC4\xBE\xA1\xC7\xEB\xC1\xA2\xBC\xB4\xB3\xE4\xB5\xE7");  /* 电量将耗尽请立即充电 */
        tjc_set_pco(n, (lv == 1) ? 62689u : 59944u);                     /* 1=橙 2/3=红 */
        tjc_set_txt(n, cb);
      }
    }
    if (lv != 0 && !page_full) tjc_lowbatt_play();    /* 进级即响一次; full 重发不响 */
  }
}



/* 设置页设备信息行: 屏端原为写死的静态文本("V1.0.0"/"SN-C4F7N-260001"), 
 *       现推真实值 -- 固件版本(编译期常量) + 产品编号(MCU 内部 Flash 持久化, 见 device_id.c)。
 * 屏端进页按"页面存的初值"绘制 -> 每次进页(full)都需重推, 由 app_refresh 的 full 分支调用。 */
static void hmi_push_device_info(void) {
  char b[48];
  snprintf(b, sizeof(b), "\xB9\xCC\xBC\xFE\xB0\xE6\xB1\xBE: %s", PRODUCT_FW_VERSION);       /* 固件版本: ... */
  tjc_set_txt(OBJ_FW_VER, b);
  snprintf(b, sizeof(b), "\xB2\xFA\xC6\xB7\xB1\xE0\xBA\xC5: %s", device_id_get());     /* 产品编号: ... */
  tjc_set_txt(OBJ_SN_STR, b);
}

/* 周期刷新(250ms): 采浓度/报警/统计峰值/写历史/刷新 */
static void app_refresh(void) {
   /* 消费 v53 的 g_rx_reattach_fail: 屏幕接收重挂失败后的自愈重试。 
   *   背景: ErrorCallback 里 HAL_UART_Receive_IT 若返回非 HAL_OK(极少数, 如 UART 仍 BUSY),
   *     接收链就断了且无人重挂 => 屏幕永久失联。
   *   每轮主循环重试一次, 直到 HAL_OK 才清标志; 不设次数上限 —— 重试本身极廉价(只发一次
   *   单字节接收请求), 且「失败就一直重试」比「放弃」更符合设备应self-heal 的定位。
   *   注意必须放在所有 USART3 发送之前, 且与 RxCpltCallback 的重挂互斥:
   *     若此处重挂成功, 标志清零后不会再重复挂; 若与 ISR 同时挂, HAL 会返回 HAL_BUSY,
   *     此时标志保持 1, 下一轮再试 —— 故无需额外临界区。 */
  if (g_rx_reattach_fail) {
    __HAL_UART_CLEAR_OREFLAG(&huart3);
    hmi_get_reset();
    if (HAL_UART_Receive_IT(&huart3, &rx_byte, 1) == HAL_OK) g_rx_reattach_fail = 0;
  }
   /* 进页补发屏障: 屏端仍在重建本页对象时, 本轮【整轮不发】。 
   * 放在最前面(重挂重试之后、消费 full 之前)是必须的:
   *   - 消费 full 会把 g_full_dirty 清零, 一旦提前 return 就再也补不回来;
   *   - hmi_push_device_info / 阈值 / 电池 chip / 顶栏芯片都在其后, 全部需要等。
   * g_full_dirty 由本函数末尾统一清零, 这里只读不清, 保证等待结束后必然全量补发。*/
  if (hmi_page_settling()) return;    /* 仍在建页窗口: 本轮什么都不发 */
   /* [L1] 消费进页全量补发标志: 本轮内所有镜像发送点无条件执行一次 */
  uint8_t full = g_full_dirty;
  if (full) { g_full_dirty = 0; hmi_push_device_info(); }    /* 进页补发设备信息行(fw/sn) */
  rtc_time_sync_poll();
  thr_hi_readback_poll();
  char buf[32];

   /* 周期读取电池更新电量 */
  battery_poll();



   /* 读取浓度(上限 SENSOR_FS_PPM, 超量程不封顶), 更新峰值/谷值 */
  g_ppm = sensor_read_ppm();
   /* 初始化遮罩窗口(上电后 BOOT_INIT_MS 内): 浓度与报警清零, 仅显示"--/初始化" */
  g_warm = ((HAL_GetTick() - g_boot_ms) < BOOT_INIT_MS) ? 1 : 0;
  if (g_warm) { g_ppm = 0.0f; g_alarm = 0; }    /* 初始化期间: 浓度显示0(屏端覆盖为--), 不报警 */
   /* 独立初始化页(页3) 锁页: 预热结束 或 收到跳过 -> 进入主页(页0), 仅一次 */
  if (g_page_init && (g_skip || !g_warm)) {
    g_page_init = 0; g_skip = 0;
    g_page_now   = 0;    /* 固件自己切的页: 屏端不会回发 0x40(那是导航按钮发的), 须自行登记当前页 */
    g_full_dirty = 1;    /* 进页全量补发: 否则主页 探头/泵 文本+圆点 停在页面初始文案(真机: 显示"探头 未连接") */
    tjc_page(0);
     /* 固件主动切页同样要过屏障: 屏端此刻开始重建主页, 本轮后续发送都会撞上 
     *   重建窗口被排队。置屏障后整轮返回, 下一轮(150ms 后)凭 g_full_dirty 全量补发。
     *   注意本轮开头已消费过一次 full 并调过 hmi_push_device_info, 但此处把
     *   g_full_dirty 重新置 1, 故下一轮仍会全量补发, 不会漏。*/
    g_page_t    = HAL_GetTick();
    g_page_wait = 1;
    return;
  }
  if (g_ppm > g_peak) g_peak = g_ppm;
  if (g_ppm < g_min)  g_min  = g_ppm;

   /* 本次测试统计: 仅测试中累计(用于历史页统计框 mx/av/mn/du/ct) */
  if (g_test) {
    unsigned p = (unsigned)g_ppm;
    g_sess_sum += p; g_sess_cnt++;
    if (p > g_sess_max) g_sess_max = (uint16_t)p;
    if (p < g_sess_min) g_sess_min = (uint16_t)p;
  }

   /* 滑动平均(环形缓冲): 满窗时减去最旧值, 只写当前值, 节省CPU */
  { static float s_ring = 0.0f;
    if (g_avg_n == AVG_WIN) s_ring -= g_avg_buf[g_avg_i];    /* 减去最旧的样本 */
    g_avg_buf[g_avg_i] = g_ppm;                               /* 写入当前值 */
    g_avg_i = (uint16_t)((g_avg_i + 1) % AVG_WIN);
    if (g_avg_n < AVG_WIN) g_avg_n++;
    s_ring += g_ppm;                                          /* 累加当前值 */
    g_avg_run = (float)(s_ring / (double)g_avg_n);           /* 取平均值 */
  }

   /* 报警等级: 0=正常 1=低报 2=高报 3=超量程 (以当前 g_thr_hi/lo 为准) */
  if (g_ppm > SENSOR_FS_PPM) g_alarm = 3;
  else if (g_thr_hi > 0 && g_ppm >= g_thr_hi) g_alarm = 2;
  else if (g_thr_lo > 0 && g_ppm >= g_thr_lo) g_alarm = 1;
  else g_alarm = 0;

   /* 报警处理: 高报/低报/超量程保持时蜂鸣, 等级变化后每2s重挂一次 */
  { static int  prev = -1;
    static uint32_t tlast = 0;
    static uint8_t  s_mute_prev = 0;        /* 上轮的 g_mute: 用于识别「取消静音」这一跳变 */
    if (g_alarm >= 2 && PP.buzzer_en) {
      uint32_t t = HAL_GetTick();
      if (g_mute) {                         /* 本次报警被临时静音, 保持哑音 */
        tjc_alarm_off();
      } else if (g_alarm != prev || (t - tlast) >= 2000u || g_mute != s_mute_prev) {
         /* 末项为新增: g_mute 由 1 -> 0(取消静音)时立即恢复鸣响。 
         *   原判据只有「等级变化」与「距上次 2s」, 取消静音时两者都不满足
         *   (g_alarm 仍 == prev, 距上次 alarm_on 通常不足 2s) => 最多哑音 2 秒。
         *   能走到这个 else 分支说明 g_mute 当前为 0, 故此处命中即「取消静音」这一跳变。 */
        tjc_alarm_on(); tlast = t;
      }
    } else {
      if (prev >= 2) tjc_alarm_off();
      if (prev >= 2 && g_alarm == 0) g_mute = 0;    /* 报警解除(从报警态回到正常): 恢复初始未静音态 */
    }
    prev = g_alarm;
    s_mute_prev = g_mute;                 /* 供下一轮识别取消静音跳变 */
  }

   /* 顶栏/状态胶囊提前下发: 原本放在本函数末尾, 但末尾之前是 
     refill_table()(历史页表格全量重绘 1749B, 9600bps 约 1.82s) => 顶栏芯片
     每轮都要等表格刷完才发出去, 用户表现为"顶栏/圆点反应慢半拍".
     现在移到报警处理之后立即发: 依赖已满足(battery_poll() 在更早的 801 行,
     g_alarm 在 838-842 刚算完, 泵状态 pump_get() 为实时读), 语义与原来完全一致,
     只是发送时机提前; 固件侧不变, 屏端不变。 */
  hmi_update_status_chips(full);    /* 刷新探头/泵/电池圆点 + 顶栏色条(L1: 变化才发, 只发当前页) */

   /* 首页静音按钮两态文本(由 MCU 按 g_mute 实时推送): 静音中显示"静音", 报警解除(静音清除)后恢复"已静音". 
     历史页"重置峰值"按钮已改名为 prst(屏端), 不再占用 bm; 故放开 g_page 限制, bm 现为主页静音按钮所属.
     [L1: 状态不变则不发; 进页由 full 补发一次] */
  { static uint8_t s_mute = 0xFFu;
    uint8_t m = g_mute ? 1u : 0u;
    if (full || m != s_mute) { s_mute = m;
      tjc_set_txt(OBJ_MUTE_BTN, m ? "\xD2\xD1\xBE\xB2\xD2\xF4" : "\xBE\xB2\xD2\xF4"); } }

   /* 首页"开始测试/停止测试"按钮(ptg)文案随 g_test 推送: 
     切页重建后屏端会回默认文案, 进页由 full 补发一次, 其余仅状态翻转时发 */
  { static uint8_t s_test = 0xFFu;
    uint8_t t = g_test ? 1u : 0u;
    if (full || t != s_test) { s_test = t;
      tjc_set_txt(OBJ_TEST_BTN, t ? "\xB2\xE2\xCA\xD4\xD6\xD0" : "\xBF\xAA\xCA\xBC\xB2\xE2\xCA\xD4"); } }

   /* 每 HIST_PERIOD_MS 写入一条历史记录到 W25Q64 (仅测试中落盘) */
  { static uint32_t hist_last = 0;
    uint32_t hn = HAL_GetTick();
    if (g_test && !g_warm && g_selftest.flash_ok && (hn - hist_last >= HIST_PERIOD_MS)) { hist_last = hn; history_log((uint16_t)g_ppm); }

     /* 历史页表格+统计 [L1 2026-09-24]: 仅历史页(g_page_now==2)刷新; 
       触发 = 进页补发(g_refill_req) / 页码或总条数变化(翻页·新记录落盘) / 5s 兜底。
       原实现无条件每 2s 全量重绘 1749B(屏口实际 115200, 约 152ms)且不管停在哪一页,
       叠加串口发送把主循环撑到秒级; 现稳态主页/设置/初始化页 0 发送。
       (历史背景: MCU 收不到屏幕翻页 0x42 事件曾致历史页恒空, 故曾无条件重绘;
        现翻页经 hmi_on_tbl_page(0x23/0x25)可达并置 g_refill_req, 保留 5s 兜底防漏。) */
     /* 刷新节奏(v76 订正注释): 三个分支的先后即优先级。
     *   1) g_refill_req     进历史页 / 翻页 / 清历史 -> 立即刷, 不等。
     *   2) 总条数或页码变化  -> 立即刷; 采样 1s 一条, 故稳态下约每秒刷一次。
     *   3) 5s 兜底          -> 仅防前两条都被绕过的情况(进页/翻页通知丢失)。
     *   => 观感是"表格约每秒多一行", 不是"5 秒才跳 5 行"。
     *   (v54 曾把测试中降频到 5s, 用户反馈"5 秒才更新、一次跳出 5 条"的观感损失,
     *    v55 已恢复为"条数变化即刷新"; 真正的抗 IWDG 防线是 refill_table 循环内喂狗
     *    与 tjc_send_raw 20ms 发送超时, 与刷新频率无关, 不应再降频。) */
    { static uint32_t rlast = 0;
      static uint32_t s_total = 0xFFFFFFFFu;
      static uint16_t s_pg = 0u;
      uint32_t tot = history_total();    /* 内存变量(g_written), 零开销 */
      if (g_refill_req) { g_refill_req = 0; rlast = hn; refill_table(); s_total = tot; s_pg = g_tbl_page; }
      else if (g_page_now == 2u && (tot != s_total || g_tbl_page != s_pg)) { rlast = hn; s_total = tot; s_pg = g_tbl_page; refill_table(); }
      else if (g_page_now == 2u && (hn - rlast >= 5000u)) { rlast = hn; s_total = tot; s_pg = g_tbl_page; refill_table(); } }
  }

   /* 主页各项刷新: 浓度/峰值/平均/状态/色块/统计 (L1: 不变量带缓存, 变化才发) */
  {
     /* 主页: 浓度显示固定 ppm (v2 已移除单位切换) 
       cc 为数值组件(type 54, 只有 .val, 无 txt 属性; 已与 cct 合并)。
       必须推 .val 而非 .txt(推 .txt 被忽略 -> 屏幕恒显示初始 0)
       浓度为实时量, 每轮发送(L1 不门控) */
    tjc_set_val(OBJ_CONC, (int)(g_ppm));
    snprintf(g_avg_str, sizeof(g_avg_str), "%.2f", (double)g_avg_run);

     /* [L1] 主页探头/泵状态文本(pc0/pc1)并入 hmi_update_status_chips 按页分发 */

     /* 流量/环境温湿度, 占位显示 */

     /* 浓度最大值/最小值文案(固定 ppm; 未记录时显示0) [L1: 取整值不变则不发] */
    { int mxi = (int)g_peak;
      int mni = (g_min > 1e6f) ? 0 : (int)g_min;
      static int s_mx = -1, s_mn = -1;
      if (full || mxi != s_mx || mni != s_mn) {
        s_mx = mxi; s_mn = mni;
        snprintf(buf, sizeof(buf), "\xD7\xEE\xB4\xF3\xD6\xB5: %.0f", (double)mxi); tjc_set_txt(OBJ_CONC_MAX, buf);
        snprintf(buf, sizeof(buf), "\xD7\xEE\xD0\xA1\xD6\xB5: %.0f", (double)mni); tjc_set_txt(OBJ_CONC_MIN, buf); } }
     /* 报警提示(2026-09-22 决策): 浓度大字 cc 随报警等级变色 + 顶栏色条 dvr 上色 
     *   正常=绿 / 低报=橙 / 高报=红 / 超量程=红 [L1: 颜色不变则不发]
     * 注: 原先的 ald(文字)/ba(均值徽章)/thv(阈值文字) 控件在屏上不存在, 已一并删除;
     *     h/l 也不再每 250ms 无条件下发(仅 g_thr_dirty / 进设置页时下发)。 */
    { uint32_t ccc = CONC_COLOR[g_alarm];
      static uint32_t s_ccc = 0xFFFFFFFFu;
      if (full || ccc != s_ccc) { s_ccc = ccc; tjc_set_pco(OBJ_CONC, ccc); } }
       /* 顶栏色条 dvr 改由 hmi_update_status_chips 按页后缀下发(见其内) */
     /* hmi_update_status_chips(full) 已上移到本轮报警处理之后(顶栏优先), 此处不再重复调用 */
  }
}

/* ---------- 历史统计 (v2 移除曲线, 仅保留右侧统计框) ---------- */
/* 历史统计下发(最大值/平均/最小/时长/点数): 历史数据页右侧 p2R 统计框 
 * v3: 统计只算本次测试期间(点击开始测试→停止测试)的真实数据 */
static void send_hist_stats(void) {
  char sbuf[24];
  if (g_sess_cnt == 0) {
    snprintf(sbuf, sizeof(sbuf), "0"); tjc_set_txt(OBJ_STAT_MAX, sbuf);
    snprintf(sbuf, sizeof(sbuf), "0"); tjc_set_txt(OBJ_STAT_AVG, sbuf);
    snprintf(sbuf, sizeof(sbuf), "0"); tjc_set_txt(OBJ_STAT_MIN, sbuf);
    snprintf(sbuf, sizeof(sbuf), "0"); tjc_set_txt(OBJ_STAT_DUR, sbuf);
    snprintf(sbuf, sizeof(sbuf), "0"); tjc_set_txt(OBJ_STAT_CNT, sbuf);
    return;
  }
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)g_sess_max);
  tjc_set_txt(OBJ_STAT_MAX, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%.1f", (double)((float)((double)g_sess_sum / (double)g_sess_cnt)));
  tjc_set_txt(OBJ_STAT_AVG, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)g_sess_min);
  tjc_set_txt(OBJ_STAT_MIN, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)((HAL_GetTick() - g_test_t0) / 1000u));
  tjc_set_txt(OBJ_STAT_DUR, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)g_sess_cnt);
  tjc_set_txt(OBJ_STAT_CNT, sbuf);
}

/* 将 epoch 秒拆分为 年月日 时分秒 (公历逆算法, 输出指针非空才写) */
static void epoch_to_civil(uint32_t t, int *yp, int *mp, int *dp, int *hp, int *mip, int *sp) {
  uint32_t days = t / 86400u, sod = t % 86400u;
  int h = (int)(sod / 3600u), mi = (int)((sod % 3600u) / 60u), s = (int)(sod % 60u);
  uint64_t z = (uint64_t)days + 719468u;
   /* 直接线性求 era/doe, 适用 1970~2106 (epoch 在 u32 范围内) */
  uint64_t era = z / 146097ul;
  uint64_t doe = z - era * 146097ul;
  unsigned yoe = (unsigned)((doe - doe/1460u + doe/36524u - doe/146096u) / 365u);
  int y = (int)yoe + (int)(unsigned)era * 400;
  unsigned doy = (unsigned)(doe - (365u*yoe + yoe/4u - yoe/100u));
  unsigned mp0 = (5u*doy + 2u)/153u;
  unsigned d = (unsigned)(doy - (153u*mp0 + 2u)/5u + 1u);
  unsigned m = (mp0<10u)?(mp0+3u):(mp0-9u);
  y += (m<=2)?1:0;
  if (yp) *yp = y; if (mp) *mp = (int)m; if (dp) *dp = (int)d;
  if (hp) *hp = h; if (mip) *mip = mi; if (sp) *sp = s;
}

/* 数据表填充: 按当前页读取 HIST_TBL_ROWS(24) 条历史, 双列填充 序号|年-月-日 时:分:秒|浓度 + 页码 */
static void refill_table(void) {
  hist_rec_t r[HIST_TBL_ROWS];
  uint16_t n, i;
  uint16_t pc, page = g_tbl_page;
  uint32_t total = history_total();    /* 历史累计条数(序号基准, 环形覆盖不回卷) */
  char s[40];

  pc = history_page_count(HIST_TBL_ROWS);    /* 总页数 */
  if (page < 1) page = 1;                    /* 页码钳位 */
  if (page > pc) page = pc;
  g_tbl_page = page;
  n = history_read_page(page, r, HIST_TBL_ROWS);

   /* 循环内喂狗: refill_table 单次调用含 24 次 flash 读 + 78 次串口发送, 
   *   是全工程最长的单次阻塞操作。**每 2 行喂一次**(v55 由 6 行加密):
   *   每 2 行最坏耗时 = 2 x 3 次 x 20ms = 120 ms, 远小于 IWDG 窗口(最快 LSI 2133 ms)
   *   => 任何局部卡顿都无法累计到超窗口而复位。这是恢复"每秒刷新"的安全前提。 */
  for (i = 0; i < HIST_TBL_ROWS; i++) {
    char tObj[8], pObj[8], sObj[8];
    char tbuf[30], vbuf[12], sbuf[6];
    if ((i % 2u) == 0u) iwdg_feed();
    if (i < n) {
      int y, mo, d, hh, mm, ss;
       /* 时间: epoch -> 年-月-日 时:分:秒 (屏 RTC 校时所得) */
      epoch_to_civil(r[i].ts, &y, &mo, &d, &hh, &mm, &ss);
      snprintf(tbuf, sizeof(tbuf), "%04d-%02d-%02d %02d:%02d:%02d", y, mo, d, hh, mm, ss);
       /* 浓度: 固定 ppm */
      snprintf(vbuf, sizeof(vbuf), "%u", (unsigned)r[i].ppm);
       /* [F/v52 语义澄清] 序号 = 【设备累计写入的第几条】(用户 2026-10-09 拍板), 最新记录最大号。 
         必须计入页码偏移: i 只是本页内的行号(0..23), 该条记录的全局倒序偏移为
         gi = (page-1)*HIST_TBL_ROWS + i (0=最新)。原实现只减 i, 于是每页都从 total 重新
         起算 -> 翻页后序号一直停在"最新一组", 与按页正确取值的时间/浓度列错位。
         关于 %9999: 这是【屏端容量限制下的显示折中】, 不是计数错误。
           - sn 控件 w=50 像素, 实测只容得下 4 位数字(对照 np0 浓度 w=90),
             而累计值满环即达 139 万位(7 位) -> 屏端放不下, 只能取模显示 4 位。
           - 故每累计到 9999 条时序号从 9999 回到 0001。
           - 内部计数 total(=g_written)本身【单调不回绕】, 翻页/取数都按它算, 逻辑无误。
         若将来屏端表格列加宽, 去掉 %9999 即可显示真实累计值(本处是唯一的取模点)。 */
      { uint32_t gi = (uint32_t)(page - 1u) * HIST_TBL_ROWS + (uint32_t)i;
        uint32_t recnum = total - gi;                /* 行0(最新)=total, 越往前递减 */
        uint32_t ser = ((recnum - 1u) % 9999u) + 1u;
        snprintf(sbuf, sizeof(sbuf), "%04lu", (unsigned long)ser); }
    } else {
      snprintf(tbuf, sizeof(tbuf), " ");
      snprintf(vbuf, sizeof(vbuf), " ");
      snprintf(sbuf, sizeof(sbuf), " ");
    }
     /* 屏端为左右双栏: 对象下标 偶=左列, 奇=右列, 行号=下标/2。 
       要求左列自上而下为第 1..12 条、右列自上而下为第 13..24 条,
       故把记录序 i 重映射到对象下标 oi: i<12 -> 左列 2*i; i>=12 -> 右列 2*(i-12)+1 */
    { uint16_t oi = (i < (HIST_TBL_ROWS / 2u)) ? (uint16_t)(2u * i)
                                               : (uint16_t)(2u * (i - HIST_TBL_ROWS / 2u) + 1u);
      snprintf(tObj, sizeof(tObj), "%s%u", OBJ_TBL_TIME_BASE, oi);    /* 时间对象 tt0..tt23 */
      tjc_set_txt(tObj, tbuf);
      snprintf(pObj, sizeof(pObj), "%s%u", OBJ_TBL_PPM_BASE, oi);     /* 浓度对象 np0..np23 */
      tjc_set_txt(pObj, vbuf);
      snprintf(sObj, sizeof(sObj), "%s%u", OBJ_TBL_SN_BASE, oi);      /* 序号对象 sn0..sn23 */
      tjc_set_txt(sObj, sbuf);
    }
  }
      snprintf(s, sizeof(s), "%u/%u", (unsigned)page, (unsigned)pc);    /* 页码文案 "当前/总页" */
   /* 写入的页码对象名("pg")必须全库唯一: 本函数每 2s 无条件执行(不管当前停在哪一页), 
     别的页若有同名对象就会被这里覆盖。主页原本的装饰横幅同名 "pg" 已改名为 ptitle。 */
  tjc_set_txt(OBJ_TBL_PAGE, s);
  send_hist_stats();
}


