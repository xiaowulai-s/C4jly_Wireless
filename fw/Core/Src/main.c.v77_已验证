     * 都不能发, 否则指令被屏端排队 -> 表现为"先显示页面默认值, 过会才跳成真实值"。
     * 这些点都读 g_full_dirty 做 full 判定, 而屏障期间该标志仍为 1, 正好被这里拦住。
     * 到点后 hmi_page_settling() 自行清标志, 本轮照常全量补发, 不丢任何一次。*/
    if (!hmi_page_settling()) {
      cal_poll();
#if !HMI_DIAG
      { static uint32_t s_dg_t = 0;
        if ((HAL_GetTick() - s_dg_t) >= 1000u) { s_dg_t = HAL_GetTick(); hmi_diag_show(); } }
#endif                         /* 标定/恢复出厂请求(主循环执行, 避免中断内阻塞) */
      hist_clear_poll();              /* 清空历史请求 */
      hmi_update_init_countdown();    /* 预热倒计时: 先于 app_refresh 发, 避免被其后大量刷新挤后 */
      hmi_update_selftest();          /* POST 结果行(pst_i): 仅初始化页/仅失败时发 (T-15) */
      low_batt_poll();                /* 低电三级提示(lb+音效): 按页下发 lb/lb_s1/lb_s2/lb_i, 4 页均需有对应对象 (T-09) */
    }
    app_refresh();
    HAL_Delay(250);
  }
