/* 阈值调整: 由屏幕按键增减阈值, MCU 为权威源做+钳位+保存+回写 */
/* 阈值上下限 (ppm): 不得超过 SENSOR_FS_PPM 上限 */
#define THR_HI_MIN   100
#define THR_HI_MAX   1500    /* 高报上限 = 量程 1500 */
static void thr_commit(void){ g_thr_hi=PP.thr_hi; g_thr_lo=PP.thr_lo; g_thr_dirty=1; g_save_pending=1; g_thr_dirty_t=HAL_GetTick(); }
void hmi_on_thr_hi_inc(void){ int v=(int)PP.thr_hi+50;                 if(v>THR_HI_MAX)v=THR_HI_MAX; PP.thr_hi=(uint16_t)v; thr_commit(); }
void hmi_on_thr_hi_dec(void){ int v=(int)PP.thr_hi-50;                 if(v<THR_HI_MIN)v=THR_HI_MIN; if(v<PP.thr_lo)v=PP.thr_lo; PP.thr_hi=(uint16_t)v; thr_commit(); }

/* 屏幕键盘(页2 b210 OK)输入高报阈值后发 0x11: ISR 只置标志 */
void hmi_on_thr_hi_set(void) { g_thr_hi_req = 1; g_thr_try = 0; g_thr_t0 = HAL_GetTick(); }   /* 记按键时刻 */

/* 采纳回读值: 双重钳位(量程内 + 不低于低报)后落盘 */
static void thr_apply_hi_val(uint32_t v) {
  if (v < THR_HI_MIN) v = THR_HI_MIN;
  if (v > THR_HI_MAX) v = THR_HI_MAX;
  if (v < PP.thr_lo)  v = PP.thr_lo;
  if ((uint16_t)v == PP.thr_hi) return;    /* 值未变: 不重复落盘/推送(设置页 load 每次回读会走到这里) */
  PP.thr_hi = (uint16_t)v;
  thr_commit();
}

/* 主循环轮询: 发起 h.val 回读(带超时与重试上限, 最多 5 次) */
static void thr_hi_readback_poll(void) {
  uint32_t now = HAL_GetTick();
  if (!g_thr_hi_req) return;
  if (g_thr_wait) { if (now > g_thr_deadline) { g_thr_wait = 0; g_get_busy = 0; } else return; }   /* 超时清 busy */
  if (g_rtc_wait) return;    /* RTC 校时占用通道 -> 本轮不发; 不消耗重试预算(让出在 g_thr_try++ 之前) */
   /* 放弃判据: 耐心时间用尽(而非重试次数用尽)。屏幕在启动期重建页面可达约 1.8s 阻塞, 
   *   原来的 500ms x 5 次窗口会把「屏还在忙」误判为「屏不响应」并静默丢弃用户按键。 */
  if ((uint32_t)(now - g_thr_t0) >= THR_HI_PATIENCE_MS) {
    g_thr_hi_req = 0; g_thr_try = 0; g_get_busy = 0; g_thr_wait = 0; return;    /* 仍须清 busy, 否则 RTC 永久堵死 */
  }
  g_thr_try++;
  g_thr_wait = 1; g_get_busy = 1; g_thr_deadline = now + 500u;
  tjc_get(OBJ_THR_HI_VAL, "val");
}

