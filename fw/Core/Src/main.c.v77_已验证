/* ---- 进页补发屏障: 等屏端把页面对象建完再发镜像 ----
 * 屏端收到 printh 4x 时正在重建整页对象, 此时收到的 "pc0d_s2.pic=1" 这类指令
 * 不会报错也不丢, 但被排队到页面建完之后才执行 => 肉眼先见页面默认值, 过会才变真值。
 * 该延迟在屏端内部, 固件侧改发送顺序/速度无效。屏障的价值是让默认值根本不出现。
 * 保留的原因: 电量文字/设备信息/阈值/标定状态/低电提示/预热倒计时仍是直写控件,
 * 会撞进重建窗口被排队。若真机仍见这些元素闪, 往上调此值即可。
 *
 * [v77] 60u -> 200u: 屏端 v11 给主页/设置/历史/厂家四页加了【页面转场动画】
 *   (页对象 effect 属性, time=150ms), 切页不再是瞬时替换, 而是在 150ms 内渐进切换,
 *   页面对象【建好】的时点被推后。60u 屏障按「瞬时切页」定, 补发会撞进动画窗口
 *   被屏端排队 -> 到执行时对象已被转场重建覆盖 => 真机症状「切页后不更新页面内容」。
 *   200u > 最大转场 150ms, 留 50us 余量(动画结束到补发之间还有串口发送耗时)。
 *   代价: 每次切页内容晚约 140ms 出现, 肉眼几乎不可见。
 *   ★ 判据: 此值必须【大于屏端最大转场 time】。屏端调大动画时, 此处要同步调大。
 *   (转场 time 实测命令: tjc-hmi-toolkit/_probe_effect.js <HMI> 可列全部页 effect/time) */
#define HMI_PAGE_SETTLE_MS   60u
static volatile uint32_t g_page_t     = 0;    /* 最近一次进页时刻 */
static volatile uint8_t  g_page_wait  = 0;    /* 1=需等待屏端建页完成 */
static volatile uint8_t  g_page_entry = 0;    /* 1=刚放行, 本轮需额外直写当前页控件一次 */

/* 供主循环里位于 app_refresh 之前的发送点(low_batt_poll 等)做同一个门控。
 * 返回 1 = 屏端仍在重建本页, 本轮不应发任何镜像。
 * 到点放行时顺带置 g_page_entry: 屏端各页 load 事件只在进页那一瞬执行一次,
 * 变量若在那之后才补发进去(冷启动吞指令/boot_resend/屏障延后), 屏端永远读不到真值
 * 且 L1 门控不重试 => 初始化页三圆点一直灰、厂家页色条不变色。
 * 故放行后第一轮额外直写一次当前页控件兜底。*/
static uint8_t hmi_page_settling(void) {
  if (!g_page_wait) return 0;
  if ((HAL_GetTick() - g_page_t) < HMI_PAGE_SETTLE_MS) return 1;
  g_page_wait  = 0;       /* 到点: 放行, 由 app_refresh 本轮做全量补发 */
  g_page_entry = 1;       /* 本轮额外直写一次, 不依赖屏端 load 是否已读 */
  return 0;
}

/* ---- 高报阈值键盘回读 (屏发 0x11 -> MCU tjc_get h.val -> 采纳) ---- 
 * ISR 只置 g_thr_hi_req; 实际 tjc_get 在主循环发起(避免 ISR 内阻塞发串口) */
static volatile uint8_t  g_thr_hi_req = 0;       /* ISR 置位: 有键盘输入待回读 */
static volatile uint8_t  g_thr_push   = 0;       /* ISR 置位: 进设置页请主循环下发阈值 */
static volatile uint8_t g_thr_wait   = 0;       /* 已发出 get, 等应答 */
/* get 应答通道的单一所有权: tjc_get 的回包不带"我是在回哪个请求"的身份, 
   阈值回读与 RTC 校时都靠 hmi_get_response() 的优先级猜 -> 可能把 RTC 读数(如 rY=2026)
   当成高报阈值采纳并落盘。现改为互斥: 任一方等应答期间, 另一方不得发 get。 */
static volatile uint8_t g_get_busy   = 0;       /* 1=get 通道已被占用(阈值优先) */
static volatile uint8_t  g_thr_try    = 0;       /* 重试计数(诊断用, 不再作为放弃判据) */
static volatile uint32_t g_thr_t0 = 0;       /* 用户按键时刻: 用「耐心时间」而非「重试次数」判定放弃 */
/* 阈值回读的放弃判据: 按墙钟耐心时间, 而非重试次数。
 * 让出(g_rtc_wait)发生在 g_thr_try++ 之前, 不消耗重试预算 —— 真正吃掉次数的是 500ms 应答超时;
 * 而上电阶段屏正在重建页面(refill_table 可阻塞), 500ms 窗口必然不够
 * => 上电后几秒内按阈值会全超时, 用户按键被静默丢弃。
 * 残留风险已核对: 放弃边界上迟到的回包会被 RTC 分支消费, 阈值范围 100~1500 与年份 2020~2099
 * 不重叠 => 被 y>=2020 校验拒绝后 RTC 自动重试, 自愈。 */
#define THR_HI_PATIENCE_MS 8000u    /* 阈值回读的等待上限(墙钟) */
static volatile uint32_t g_thr_deadline = 0;     /* 应答超时 tick */
static void thr_apply_hi_val(uint32_t v);
static void thr_hi_readback_poll(void);
static void hmi_push_device_info(void);    /* 设置页设备信息行(fw/sn)按需下发 */

/* ---------- IWDG 前置声明 ---------- */
static void iwdg_enable(void);  static void iwdg_feed(void);

/* ---------- 硬件独立看门狗(IWDG) ---------- 
 * 动机: 原「看门狗」是软件模拟(仅主循环喂狗), 一旦 HardFault / Error_Handler 死循环,
 *   主循环停 -> 软件喂狗永不执行 -> NVIC_SystemReset() 永不触发 -> 设备永久死机。
 *   IWDG 由独立 LSI 驱动、不依赖 CPU, 是这类死锁场景下唯一的自愈手段。
 * 参数: LSI≈40kHz(typ)/30~60kHz 范围, 取 /32 分频 + 计数 4000 => 约 3.2 s。
 *   上限受 LSI 精度影响(最坏 60kHz -> 约 2.1 s, 最慢 30kHz -> 约 4.3 s),
 *   故窗口留足余量: 主循环正常节拍 250 ms, 阻塞操作最长约 0.5 s(flash 擦除/表格刷新),
 *   3~4 s 窗口不会误触发。 */
#define IWDG_PRESCALER   32u /* LSI/32 */
#define IWDG_RELOAD      4000u      /* ≈3.2 s @40kHz */
static IWDG_HandleTypeDef hiwdg;
static void iwdg_hw_start(void);

/* ---- 屏幕回读处理: 收到 get 应答或 printh 单字节 ---- */
/* 说明: 每收到 1 字节, 先喂给 hmi_get_feed 判断是否为 get 应答帧(0x70/0x71 帧头), 
 *   帧完成则按应答帧处理(回读值/状态); 非帧字节才转 hmi_on_rx_byte 分发;
 *   帧中间的字节必须丢弃(否则数值字节会撞业务命令码) */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  if (huart != NULL && huart->Instance != USART3) return;    /* 非串口屏串口忽略 */
  {
#if !HMI_DIAG
    hmi_diag_any(rx_byte);    /* 总字节数; 0x1A/0x1B 计数由 hmi_on_rx_byte 内统一统计 */
#endif
    int gr = hmi_get_feed(rx_byte);    /* 1=帧完成, 0=非帧字节, -1=帧中间字节 */
    if (gr > 0) {
       /* 一帧 get 应答处理, 分派到对应(回读值/标定值/状态等) */
      hmi_get_response();
    } else if (gr == 0) {
       /* 与任何帧无关的字节: 普通单字节命令, 分发到命令分发器 */
      hmi_on_rx_byte(rx_byte);
    }
     /* gr < 0: 帧中间字节, 必须丢弃 —— 否则 get 应答的数值字节(如秒值 7) 
       会被当业务命令执行(0x07 跳过初始化 -> 一开机就跳页)。 */
  }
   /* 每次回调后重新使能接收单字节中断 */
  (void)HAL_UART_Receive_IT(huart, &rx_byte, 1);    /* 返回值不再丢弃: 见 g_rx_reattach_fail */
}

/* USART3 错误回调 —— 修复「一次 ORE 即屏幕永久失联且不自愈」 
 *
 * 背景: 本工程用单字节 HAL_UART_Receive_IT 接收屏命令, 且**从未实现本回调**。
 *   单字节接收下, 只要屏端 UART 因电磁干扰 / 屏重启脏数据 / 热插拔收到一个噪声字节,
 *   第二个字节在处理第一个的窗口内到达 => ORE(Overrun)。STM32 HAL 把 ORE 归为
 *   blocking error: 调 UART_EndRxTransfer() 清掉 CR1.RXNEIE 且 RxState 置READY。
 *   而错误分支**只调本回调** => RxCpltCallback 永不触发 => Receive_IT 永不重挂
 *   => 屏幕接收永久失效(触摸无响应)且无法自愈, 现场表现为「屏突然失灵, 重启才好」。
 *
 * 修法: 清 ORE(必须先读 SR 再读 DR 才能真正清) + 重挂接收 + 复位 get 帧状态机。
 */
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart) {
  if (huart == NULL || huart->Instance != USART3) return;    /* 只处理屏幕串口 */
  __HAL_UART_CLEAR_OREFLAG(huart);           /* 清 ORE: 读 SR 后读 DR, 由宏完成 */
  hmi_get_reset();                 /* 丢掉可能残留的半帧, 避免下次被当业务命令 */
  if (HAL_UART_Receive_IT(huart, &rx_byte, 1) != HAL_OK) {
    g_rx_reattach_fail = 1;         /* 置位: app_refresh 每轮会重试直到成功(见该处) */
  }
}

/* 处理一帧屏幕的 get 应答: 判断是 RTC 同步还是阈值回读值 */
void hmi_get_response(void) {
  uint32_t v = hmi_get_value();

   /* 阈值键盘回读应答(0x11): 采纳并落盘。用 g_get_busy 而非 g_thr_wait 判定, 
     因为 g_thr_wait 只表示"阈值已发出 get", 而 g_get_busy 才是"通道归属阈值"。 */
  if (g_get_busy) {
    g_get_busy = 0; g_thr_wait = 0; g_thr_hi_req = 0; g_thr_try = 0;
    thr_apply_hi_val(v);
    return;
  }

  if (g_sync_st >= 2u || !g_rtc_wait) return;    /* 非本次校时的回包, 忽略 */

  if (g_sync_st == 0u) {                         /* 活性探测: 秒值必须变化, 否则屏端镜像尚未刷新 */
    g_rtc_wait = 0;
    if (g_time_sync_idx == 0u) { g_sync_sec0 = v; g_time_sync_idx = 1u; g_sync_t0 = HAL_GetTick(); }
    else if (v != g_sync_sec0) { g_sync_st = 1u; g_time_sync_idx = 0; }   /* 秒值已走 -> 镜像有效 */
    else { g_sync_sec0 = v; g_sync_t0 = HAL_GetTick(); }                  /* 未变化 -> 再探一轮 */
    return;
  }

  g_sync_rtc[g_time_sync_idx] = v;               /* st==1: 依次收 rY/rM/rD/rH/rMi/rsec */
  g_rtc_wait = 0;
  if (++g_time_sync_idx >= 6u) {                 /* 6 项取齐: 校验合理性后换算 epoch */
    uint32_t y = g_sync_rtc[0], mo = g_sync_rtc[1], d = g_sync_rtc[2];
    if (y >= 2020u && y <= 2099u && mo >= 1u && mo <= 12u && d >= 1u && d <= 31u) {
      g_wall_epoch = rtc_to_epoch(y, mo, d, g_sync_rtc[3], g_sync_rtc[4], g_sync_rtc[5]);
      g_wall_tick  = HAL_GetTick();
      g_sync_st = 2u;                            /* 校时完成, 不再打扰屏 */
    } else {
      g_sync_st = 1u; g_time_sync_idx = 0;       /* 数值不合理 -> 重读 */
    }
  }
}


/* 将当前存储的高报阈值下发到屏幕 h, 保证屏幕与固件一致 
 * 注: 低报阈值已在 2026-09-22 决策中取消屏端调节(l/thv 控件与 0x04/0x05 一并删除),
 *     故此处不再下发 l。改为"仅条件下发"后, 屏上 h 的值不再每 250ms 被刷新。 */
static void app_apply_threshold(void) {
  g_thr_hi = PP.thr_hi; g_thr_lo = PP.thr_lo;
  tjc_set_val(OBJ_THR_HI_VAL, g_thr_hi);
   /* 同步写屏端全局变量 thr: 设置页 load/tm0 用它刷新 h.val。 
   * 原因: TJC 进页按"页面里存的初值"绘制, 而 h 的页面初值是 500;
   * 只推对象 h 无法覆盖这次绘制, 必须由页面自己从 thr 刷新。 */
  tjc_set_var(SCREEN_VAR_THR, g_thr_hi);
}

/* ---------- 看门狗: 约4s未喂狗则强制复位 ---------- */
static uint32_t g_iwdg_t = 0;
static uint8_t  g_iwdg_on = 0;
static void iwdg_enable(void) { g_iwdg_on = 1; g_iwdg_t = HAL_GetTick(); }
static void iwdg_feed(void) {
  if (g_iwdg_on && (HAL_GetTick() - g_iwdg_t) > 4000u) NVIC_SystemReset();   /* 超时未喂狗 -> 复位 */
  g_iwdg_t = HAL_GetTick();
  HAL_IWDG_Refresh(&hiwdg);    /* 同时喂硬件看门狗(硬件喂狗无条件执行, 与 g_iwdg_on 无关) */
}

/* 启动硬件 IWDG: 使能 LSI -> 配 PRESC/RELOAD -> 启动。 
 * 一旦启动即不可关闭(寄存器写保护), 只能等复位 —— 故放在上电初始化末尾。 */
static void iwdg_hw_start(void) {
  RCC_OscInitTypeDef osc = {0};
  osc.OscillatorType = RCC_OSCILLATORTYPE_LSI;    /* LSI 由 RCC 统一使能(HAL 内部会等就绪) */
  osc.LSIState     = RCC_LSI_ON;
  osc.PLL.PLLState = RCC_PLL_NONE;                 /* 必需: 关 PLL 省电, 避免 LSI 启用时被等待 */
  (void)HAL_RCC_OscConfig(&osc);
  hiwdg.Instance = IWDG;
  hiwdg.Init.Prescaler = IWDG_PRESCALER;
  hiwdg.Init.Reload    = IWDG_RELOAD;
  (void)HAL_IWDG_Init(&hiwdg);    /* 初值约 3.2 s */
}

/* ---------- 由 RTC 时间换算为 epoch ---------- */
uint32_t rtc_wall_seconds(void) {
  return g_wall_epoch + (uint32_t)((HAL_GetTick() - g_wall_tick) / 1000u);   /* 基准+已过秒数 */
}
/* 由 年/月/日/时/分/秒 转换为纪元秒 */
static uint32_t rtc_to_epoch(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s) {
  int yy = (int)y, mm = (int)mo;
  yy -= (mm <= 2);
  int era = (yy >= 0 ? yy : yy - 399) / 400;
  unsigned yoe = (unsigned)(yy - era * 400);
  unsigned month = (unsigned)(mm + (mm > 2 ? -3 : 9));
  unsigned doy = (153u * month + 2u) / 5u + (unsigned)d - 1u;
  unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
  uint32_t days = (uint32_t)(era * 146097) + doe - 719468u;
  return days * 86400u + h * 3600u + mi * 60u + s;
}
/* 启动时间同步: 进入秒值活性探测阶段 */
static void rtc_time_start_sync(void) {
  g_sync_st = 0; g_time_sync_idx = 0; g_rtc_wait = 0; g_sync_sec0 = 0xFFFFFFFFu;
  g_sync_t0 = HAL_GetTick();
}
static void rtc_time_finalize(void) {
  g_sync_st = 2;    /* (预留) 结束本次校时 */
}
/* 屏端真实时间镜像组件(0~5 = 年月日时分秒), 取【初始化页(页3)】上的那套: 
 *   开机即停在页4, 其 tm0_i(tim=300) 在跑并绑定 rsec_i.val=rtc5;
 *   而主页(4.pa)上的同名 tm0/rY/rsec 在页4 期间不运行, 秒值不走 ->
 *   活性探测(v != g_sync_sec0)永不成立 -> 校时卡死 -> 时间戳退化为 1970。 */
static const char *const RTC_MIRROR[6] = { "rY_i","rM_i","rD_i","rH_i","rMi_i","rsec_i" };
/* 轮询驱动校时(每 250ms 调一次): 失败不放弃, 屏端就绪/镜像刷新后自动完成 */
static void rtc_time_sync_poll(void) {
  uint32_t now = HAL_GetTick();
  if (g_sync_st >= 2u) return;                                           /* 已完成 */
  if (g_sync_st == 0u && g_time_sync_idx >= 1u) {                        /* 活性探测: 首读后等 1.2s 再复读秒值 */
    if ((uint32_t)(now - g_sync_t0) < 1200u) return;
  }
  if (g_rtc_wait) {                                                      /* 等本步应答 */
    if (now > g_sync_deadline) { g_rtc_wait = 0; g_time_sync_idx = 0; }  /* 无应答: 本阶段重来 */
    return;
  }
  if (g_get_busy) return;    /* 阈值回读占用通道 -> 本轮不发, 下轮再试(校时会自动重试, 不会丢) */
  g_rtc_wait = 1; g_sync_deadline = now + 500u;                          /* 单步应答窗口 500ms */
  tjc_get((g_sync_st == 0u) ? "rsec_i" : RTC_MIRROR[g_time_sync_idx], "val");
}
