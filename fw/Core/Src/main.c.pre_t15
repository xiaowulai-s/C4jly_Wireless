#define BOOT_INIT_MS   60000u        /* 上电初始化遮罩时长 */
/* 跳过初始化的开机静默窗口: 挡上电触摸噪声/屏自校准误触
 *   页4 上 skip(t98,未锁定) 与 lg_i(t112) 热区重叠于左上角, 两者都挂 printh 07;
 *   g_skip 置位后不可撤销 -> 一次误触即跳页。上电噪声集中在屏幕点亮最初几秒, 故设此窗口。
 *   基准用 HAL_GetTick() 自身: g_boot_ms 要到遮罩计时起点才赋值, 不可作开机基准。 */
#define SKIP_ARM_MS    5000u         /* 开机 5s 内不响应跳过命令 */

