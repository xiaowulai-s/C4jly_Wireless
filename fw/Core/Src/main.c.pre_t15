/* ---- 时间同步 RTC 相互校时 (方案A: MCU 读取屏幕时间并回写屏时) ---- */
/* 校时状态机: 0=秒值活性探测(排除屏端未启动时的设计初值) 1=读取 6 项镜像 2=已完成 */
static volatile uint8_t  g_sync_st    = 0;     /* 校时阶段 */
static volatile uint8_t  g_time_sync_idx = 0;  /* 阶段内步序: 探测 0/1, 读取 0..5 */
static volatile uint8_t  g_rtc_wait = 0;       /* 已发出 get, 等应答 */
static volatile uint32_t g_sync_deadline = 0;  /* 本步应答超时 tick */
static volatile uint32_t g_sync_t0 = 0;        /* 阶段计时起点 */
static volatile uint32_t g_sync_sec0 = 0xFFFFFFFFu; /* 活性探测首次读到的秒值 */
static volatile uint32_t g_sync_rtc[6];        /* 缓冲: rY/rM/rD/rH/rMi/rsec 的回读值 */
static volatile uint32_t g_wall_epoch = 0;     /* 同步得到的 epoch 秒 */
static volatile uint32_t g_wall_tick  = 0;     /* 同步时刻的 HAL_GetTick() */
static uint32_t rtc_to_epoch(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s);
static void rtc_time_start_sync(void);
static void rtc_time_finalize(void);
static void rtc_time_sync_poll(void);
uint32_t rtc_wall_seconds(void);

/* ---- 报警配色 (与屏端 dvr 色条一致): 0=正常 1=低报 2=高报 3=超量程 ----
 * 必须在此处定义: app_refresh() 早于文件后段的阈值段使用它 */
static const uint32_t ALARM_COLOR[4] = { C_STRIP_GREEN, C_STRIP_ORANGE, C_STRIP_RED, C_STRIP_RED };

/* ---- L1 串口减量(2026-09-24): 镜像脏标记, 仅变化才发; 进页全量补发 ----
 * 背景: app_refresh 每轮阻塞发约 567B(9600bps 约0.59s), refill_table 每2s 再发 1749B,
 * 主循环被阻塞式发送卡到 0.84~2.66s, 触摸响应延迟 0.4~1.3s。
 * 本组标志让周期刷新降为"变化才发", 稳态 TX 线路占用从 ~330% 降到 <10%。 */
static volatile uint8_t g_page_now   = 0xFFu; /* 固件视角当前页(0x40+p): 0=主页 1=设置 2=历史; 0xFF=未知(上电初始化页无进页事件, 由 g_page_init 判断) */
static volatile uint8_t g_full_dirty = 1;     /* 上电/进页置1: 下一轮 app_refresh 全量补发镜像(切页重建后屏端控件回默认值) */
static volatile uint8_t g_refill_req = 0;     /* 进历史页/翻页补发表格(主循环执行, 回调内不再阻塞发送) */

/* ---- 高报阈值键盘回读 (屏发 0x11 -> MCU tjc_get h.val -> 采纳) ----
 * ISR 只置 g_thr_hi_req; 实际 tjc_get 在主循环发起(避免 ISR 内阻塞发串口) */
static volatile uint8_t  g_thr_hi_req = 0;      /* ISR 置位: 有键盘输入待回读 */
static volatile uint8_t  g_thr_push   = 0;      /* ISR 置位: 进设置页请主循环下发阈值 */
static volatile uint8_t  g_thr_wait   = 0;      /* 已发出 get, 等应答 */
static volatile uint8_t  g_thr_try    = 0;      /* 重试计数 */
static volatile uint32_t g_thr_deadline = 0;    /* 应答超时 tick */
static void thr_apply_hi_val(uint32_t v);
static void thr_hi_readback_poll(void);

/* ---- IWDG 看门狗 前置声明 ---- */
static void iwdg_enable(void);  static void iwdg_feed(void);

/* ---- 屏幕回读处理: 收到 get 应答或 printh 单字节 ---- */
/* 说明: 每收到 1 字节, 先喂给 hmi_get_feed 判断是否为 get 应答帧(0x70/0x71 帧头),
 *   帧完成则按应答帧处理(回读值/状态); 非帧字节才转 hmi_on_rx_byte 分发;
 *   帧中间的字节必须丢弃(否则数值字节会撞业务命令码) */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  if (huart != NULL && huart->Instance != USART3) return;   /* 非串口屏串口忽略 */
  {
    int gr = hmi_get_feed(rx_byte);   /* 1=帧完成, 0=非帧字节, -1=帧中间字节 */
    if (gr > 0) {
      /* 一帧 get 应答处理, 分派到对应(回读值/标定值/状态等) */
      hmi_get_response();
    } else if (gr == 0) {
      /* 与任何帧无关的字节: 普通单字节命令, 分发到命令分发器 */
      hmi_on_rx_byte(rx_byte);
    }
    /* gr < 0: 帧中间字节, 必须丢弃 —— 否则 get 应答的数值字节(如秒值 7)
       会被当业务命令执行(0x07 跳过初始化 -> 一开机就跳页)。 */
  }
  /* 每次回调后重新使能接收单字节中断 */
  HAL_UART_Receive_IT(huart, &rx_byte, 1);
}

/* 处理一帧屏幕的 get 应答: 判断是 RTC 同步还是阈值回读值 */
void hmi_get_response(void) {
  uint32_t v = hmi_get_value();

  /* 阈值键盘回读应答(0x11): 采纳并落盘 */
  if (g_thr_wait) {
    g_thr_wait = 0; g_thr_hi_req = 0; g_thr_try = 0;
    thr_apply_hi_val(v);
    return;
  }

  if (g_sync_st >= 2u || !g_rtc_wait) return;   /* 非本次校时的回包, 忽略 */

  if (g_sync_st == 0u) {                        /* 活性探测: 秒值必须变化, 否则屏端镜像尚未刷新 */
    g_rtc_wait = 0;
    if (g_time_sync_idx == 0u) { g_sync_sec0 = v; g_time_sync_idx = 1u; g_sync_t0 = HAL_GetTick(); }
    else if (v != g_sync_sec0) { g_sync_st = 1u; g_time_sync_idx = 0; }  /* 秒值已走 -> 镜像有效 */
    else { g_sync_sec0 = v; g_sync_t0 = HAL_GetTick(); }                 /* 未变化 -> 再探一轮 */
    return;
  }

  g_sync_rtc[g_time_sync_idx] = v;              /* st==1: 依次收 rY/rM/rD/rH/rMi/rsec */
  g_rtc_wait = 0;
  if (++g_time_sync_idx >= 6u) {                /* 6 项取齐: 校验合理性后换算 epoch */
    uint32_t y = g_sync_rtc[0], mo = g_sync_rtc[1], d = g_sync_rtc[2];
    if (y >= 2020u && y <= 2099u && mo >= 1u && mo <= 12u && d >= 1u && d <= 31u) {
      g_wall_epoch = rtc_to_epoch(y, mo, d, g_sync_rtc[3], g_sync_rtc[4], g_sync_rtc[5]);
      g_wall_tick  = HAL_GetTick();
      g_sync_st = 2u;                           /* 校时完成, 不再打扰屏 */
    } else {
      g_sync_st = 1u; g_time_sync_idx = 0;      /* 数值不合理 -> 重读 */
    }
  }
}


/* 将当前存储的高报阈值下发到屏幕 h, 保证屏幕与固件一致
 * 注: 低报阈值已在 2026-09-22 决策中取消屏端调节(l/thv 控件与 0x04/0x05 一并删除),
 *     故此处不再下发 l。改为"仅条件下发"后, 屏上 h 的值不再每 250ms 被刷新。 */
static void app_apply_threshold(void) {
  g_thr_hi = PP.thr_hi; g_thr_lo = PP.thr_lo;
  tjc_set_val(OBJ_THR_HI_VAL, g_thr_hi);
  /* 同步写屏端全局变量 thr: 设置页 load/tm0 用它刷新 h.val。
   * 原因: TJC 进页按"页面里存的初值"绘制, 而 h 的页面初值是 500;
   * 只推对象 h 无法覆盖这次绘制, 必须由页面自己从 thr 刷新。 */
  tjc_set_var(SCREEN_VAR_THR, g_thr_hi);
}

/* ---------- 看门狗: 约4s未喂狗则强制复位 ---------- */
static uint32_t g_iwdg_t = 0;
static uint8_t  g_iwdg_on = 0;
static void iwdg_enable(void) { g_iwdg_on = 1; g_iwdg_t = HAL_GetTick(); }
static void iwdg_feed(void) {
  if (g_iwdg_on && (HAL_GetTick() - g_iwdg_t) > 4000u) NVIC_SystemReset();  /* 超时未喂狗 -> 复位 */
  g_iwdg_t = HAL_GetTick();
}

/* ---------- 由 RTC 时间换算为 epoch ---------- */
uint32_t rtc_wall_seconds(void) {
  return g_wall_epoch + (uint32_t)((HAL_GetTick() - g_wall_tick) / 1000u);  /* 基准+已过秒数 */
}
/* 由 年/月/日/时/分/秒 转换为纪元秒 */
static uint32_t rtc_to_epoch(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s) {
  int yy = (int)y, mm = (int)mo;
  yy -= (mm <= 2);
  int era = (yy >= 0 ? yy : yy - 399) / 400;
  unsigned yoe = (unsigned)(yy - era * 400);
  unsigned month = (unsigned)(mm + (mm > 2 ? -3 : 9));
  unsigned doy = (153u * month + 2u) / 5u + (unsigned)d - 1u;
  unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
  uint32_t days = (uint32_t)(era * 146097) + doe - 719468u;
  return days * 86400u + h * 3600u + mi * 60u + s;
}
/* 启动时间同步: 进入秒值活性探测阶段 */
static void rtc_time_start_sync(void) {
  g_sync_st = 0; g_time_sync_idx = 0; g_rtc_wait = 0; g_sync_sec0 = 0xFFFFFFFFu;
  g_sync_t0 = HAL_GetTick();
}
static void rtc_time_finalize(void) {
  g_sync_st = 2;   /* (预留) 结束本次校时 */
}
/* 屏端真实时间镜像组件(0~5 = 年月日时分秒), 取【初始化页(页3)】上的那套:
 *   开机即停在页4, 其 tm0_i(tim=300) 在跑并绑定 rsec_i.val=rtc5;
 *   而主页(4.pa)上的同名 tm0/rY/rsec 在页4 期间不运行, 秒值不走 ->
 *   活性探测(v != g_sync_sec0)永不成立 -> 校时卡死 -> 时间戳退化为 1970。 */
static const char *const RTC_MIRROR[6] = { "rY_i","rM_i","rD_i","rH_i","rMi_i","rsec_i" };
/* 轮询驱动校时(每 250ms 调一次): 失败不放弃, 屏端就绪/镜像刷新后自动完成 */
static void rtc_time_sync_poll(void) {
  uint32_t now = HAL_GetTick();
  if (g_sync_st >= 2u) return;                                          /* 已完成 */
  if (g_sync_st == 0u && g_time_sync_idx >= 1u) {                       /* 活性探测: 首读后等 1.2s 再复读秒值 */
    if ((uint32_t)(now - g_sync_t0) < 1200u) return;
  }
  if (g_rtc_wait) {                                                     /* 等本步应答 */
    if (now > g_sync_deadline) { g_rtc_wait = 0; g_time_sync_idx = 0; } /* 无应答: 本阶段重来 */
    return;
  }
  g_rtc_wait = 1; g_sync_deadline = now + 500u;                         /* 单步应答窗口 500ms */
  tjc_get((g_sync_st == 0u) ? "rsec_i" : RTC_MIRROR[g_time_sync_idx], "val");
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART3_UART_Init();   /* serial screen USART3 */
  MX_SPI1_Init();
  MX_ADC1_Init();   /* battery: ADC1 IN9/PB1 (hadc1) */

  /* USER CODE BEGIN 2 */
  /* ---- 外设初始化 ---- */
  /* 传感器: 通过 UART4 读取浓度的文本 */
  sensor_init();

  /* 电池: ADC1(IN9/PB1)电压采样, 循环采样 */
  battery_init();
  battery_poll();
  /* 泵: 初始化默认停止 */
  pump_init();

  /* 存储: 历史记录 + 参数存储(标定/阈值) */
  w25q16_init();
  param_init(&PP);
  history_init();
  /* 从 flash 恢复阈值等参数到内存, 并应用 */
  g_thr_hi = PP.thr_hi;
  g_thr_lo = PP.thr_lo;
  sensor_set_cal(PP.cal_k, PP.cal_b);

  /* 启动自检 (D3): 外设只读检测, 结果用于状态圆点置灰 */
  selftest_run(&g_selftest);

  /* 使能串口屏接收中断, 收到字节交回调处理/应答 */
  HAL_UART_Receive_IT(&huart3, &rx_byte, 1);

  /* 切到独立初始化页(页3), 预热完成或跳过后再进主页(页0) */
  tjc_page(3);
  /* 屏冷启动需1~3s, 上电首发指令可能被吞: 延时后补发两次兜底(页4重入无副作用) */
  HAL_Delay(1500);
  tjc_page(3);
  HAL_Delay(1000);
  tjc_page(3);
  app_apply_threshold();
  rtc_time_start_sync();

  /* 上电初始化遮罩计时起点 */
  g_boot_ms = HAL_GetTick();

  /* 使能看门狗, 由循环定时喂狗 */
  iwdg_enable();
  iwdg_feed();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    iwdg_feed();
    if (g_thr_dirty || g_thr_push) { g_thr_dirty = 0; g_thr_push = 0; app_apply_threshold(); }
    if (g_save_pending && (HAL_GetTick() - g_thr_dirty_t) >= 200u) { g_save_pending = 0; param_save(&PP); }
    cal_poll();                    /* 标定/恢复出厂请求(主循环执行, 避免中断内阻塞) */
    hist_clear_poll();             /* 清空历史请求 */
    hmi_update_init_countdown();   /* 预热倒计时: 先于 app_refresh 发, 避免被其后大量刷新挤后 */
    app_refresh();
    HAL_Delay(250);
  }
  /* USER CODE END 3 */
}

