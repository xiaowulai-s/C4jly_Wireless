#define HMI_CMD_ALARM_ON()     sprintf(cmd, "play 0,%d,1",    (int)(HMI_AUDIO_ID))
#define HMI_CMD_ALARM_OFF()    sprintf(cmd, "audio0=%d",      (int)(0))
#define HMI_CMD_GET(obj,prop)          sprintf(cmd, "get %s.%s",    (obj), (prop))

