/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART3_UART_Init();   /* serial screen USART3 */
  MX_SPI1_Init();
  MX_ADC1_Init();   /* battery: ADC1 IN9/PB1 (hadc1) */

  /* USER CODE BEGIN 2 */
  /* ---- 传感器初始化 ---- */
  /* 传感器: 通过 UART4 读取浓度文本 */
  sensor_init();

  /* 电量: ADC1(IN9/PB1)分压采样, 循环更新 */
  battery_init();
  battery_poll();
  /* 泵: 初始化默认停止 */
  pump_init();

  /* 存储: 历史记录 + 运行参数(标定/阈值) */
  w25q16_init();
  history_init();
  param_init(&PP);
  /* 从 flash 恢复阈值与标定系数(上电回显) */
  g_thr_hi = PP.thr_hi;
  g_thr_lo = PP.thr_lo;
  sensor_set_cal(PP.cal_k, PP.cal_b);

  /* 使能屏端串口单字节接收中断, 回调解析命令/应答 */
  HAL_UART_Receive_IT(&huart3, &rx_byte, 1);

  /* 上电切回主页, 同步阈值/单位显示, 并启动一次时间同步 */
  tjc_page(0);
  app_apply_threshold();
  app_apply_unit();
  rtc_time_start_sync();

  /* 使能软件看门狗, 主循环周期喂狗 */
  iwdg_enable();
  iwdg_feed();

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    iwdg_feed();
    if (g_thr_dirty) { g_thr_dirty = 0; app_apply_threshold(); }
    if (g_save_pending && (HAL_GetTick() - g_thr_dirty_t) >= 200u) { g_save_pending = 0; param_save(&PP); }
    app_refresh();
    HAL_Delay(250);
  }
  /* USER CODE END 3 */
}

