/* ---------- 系统状态 ---------- */
static float g_ppm  = 0.0f;          /* 当前浓度(ppm) */
static float g_peak = 0.0f;          /* 峰值: 历史最大浓度 */
static float g_min  = 4294967.0f;    /* 谷值: 历史最小浓度; 初值为哨兵值表示"未记录" */
static int   g_thr_hi = 500;         /* 高报警阈值(ppm) */
static int   g_thr_lo = 100;         /* 低报警阈值(ppm) */
static int   g_alarm  = 0;           /* 报警等级: 0=正常 1=低报 2=高报 3=超量程 */
#define ZERO_CAL_THRESHOLD_PPM  20  /* zero cal thr ppm */
static int g_warm = 0;               /* 预热标志(sensor_warmup: 预热期间抑制报警、浓度置0) */
static char  g_avg_str[16];
static int g_page = 0;               /* 当前页 0..3 */
static int g_view = 0;               /* 历史页视图: 0=曲线 1=数据表 */
static uint16_t g_tbl_page = 1;      /* 数据表当前页(从1起) */

/* 历史波形点数 = 采样点数(1点/秒 => 约11分钟可记录) */
#define WAVE_PTS        672u
/* 平均窗口: 滑动平均窗口宽度(60点, 约1分钟) */
#define AVG_WIN         60u
static float    g_avg_run = 0.0f;    /* 滑动平均浓度(主页显示) */
static float    g_avg_buf[AVG_WIN];  /* 滑动平均环形缓冲 */
static uint16_t g_avg_i = 0, g_avg_n = 0;

/* 运行参数(标定系数 + 阈值 + 单位), 存于 W25Q16 */
param_t g_param;
#define PP  g_param
static uint8_t  g_thr_dirty   = 0;   /* thresholds changed, save pending */
static uint32_t g_thr_dirty_t = 0;   /* tick of last threshold change */
static uint8_t  g_save_pending = 0;  /* thresholds need flash save */

static void hmi_get_response(void);

uint8_t rx_byte;                     /* USART3 屏端单字节接收缓存 */
#define GY_PER_PPM 0.458f            /* 单位换算: 1ppm ≈ 0.458 g/y */

