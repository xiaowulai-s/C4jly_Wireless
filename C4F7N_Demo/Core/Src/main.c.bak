/* ---------- app_refresh: 周期刷新 ---------- */
/* 刷新主页/各页状态圆点(探头/泵/电池), 各页同步一致 */
static void hmi_update_status_chips(void) {
  int probe = sensor_online();
  int pct   = battery_get_pct();
  uint16_t bpic;

  tjc_pic(OBJ_DOT_PROBE, probe ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PUMP,  pump_get() ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  /* 探头/泵状态: 各页圆点同步 */
  tjc_pic(OBJ_DOT_PROBE_P1, probe ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PUMP_P1,  pump_get() ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PROBE_P2, probe ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PUMP_P2,  pump_get() ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PROBE_P3, probe ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  tjc_pic(OBJ_DOT_PUMP_P3,  pump_get() ? PIC_DOT_GREEN : PIC_DOT_GRAY);
  /* 电池圆点: 按电量分级 绿/黄/红 */
  bpic = (pct >= BAT_DOT_WARN_PCT) ? (uint16_t)PIC_DOT_GREEN
       : (pct >= BAT_DOT_LOW_PCT)  ? (uint16_t)PIC_DOT_AMBER
       : (uint16_t)PIC_DOT_RED;
  tjc_pic(OBJ_DOT_BAT, bpic);
  tjc_pic(OBJ_DOT_BAT_P1, bpic);
  tjc_pic(OBJ_DOT_BAT_P2, bpic);
  tjc_pic(OBJ_DOT_BAT_P3, bpic);
}

/* 主周期刷新(250ms): 读浓度/算报警/更新阈值/写历史/刷屏 */
static void app_refresh(void) {
  rtc_time_sync_poll();
  /* 关于页: 探头状态文本每周期刷新, 在线绿色/离线红色 */
  if (g_page == 3) {
    int probe = sensor_online();
    tjc_set_txt(OBJ_PROBE_ST, probe ? "\xCC\xBD\xCD\xB7 \xD2\xD1\xC1\xAC\xBD\xD3" : "\xCC\xBD\xCD\xB7 \xCE\xB4\xC1\xAC\xBD\xD3");
    tjc_set_pco(OBJ_PROBE_ST, probe ? C_STRIP_GREEN : C_STRIP_RED);
  }
  char buf[32];

  /* 电量采样并更新 */
  battery_poll();



  /* 读取浓度(满量程 SENSOR_FS_PPM, 超量程不封顶), 更新峰值/谷值 */
  g_ppm = sensor_read_ppm();
  g_warm = sensor_warmup();
  if (g_warm) { g_ppm = 0.0f; g_alarm = 0; }   /* 预热期: 浓度与报警置零 */
  if (g_ppm > g_peak) g_peak = g_ppm;
  if (g_ppm < g_min)  g_min  = g_ppm;

  /* 滑动平均(环形缓冲): 缓冲已满时先减去被挤出的最旧值, 再写入当前值, 节省CPU */
  { static float s_ring = 0.0f;
    if (g_avg_n == AVG_WIN) s_ring -= g_avg_buf[g_avg_i];   /* 减去待覆盖的最旧值 */
    g_avg_buf[g_avg_i] = g_ppm;                              /* 写入当前值 */
    g_avg_i = (uint16_t)((g_avg_i + 1) % AVG_WIN);
    if (g_avg_n < AVG_WIN) g_avg_n++;
    s_ring += g_ppm;                                         /* 累加当前值 */
    g_avg_run = (float)(s_ring / (double)g_avg_n);          /* 取平均值 */
  }

  /* 报警等级: 0=正常 1=低报 2=高报 3=超量程 (以当前 g_thr_hi/lo 为准) */
  if (g_ppm > SENSOR_FS_PPM) g_alarm = 3;
  else if (g_thr_hi > 0 && g_ppm >= g_thr_hi) g_alarm = 2;
  else if (g_thr_lo > 0 && g_ppm >= g_thr_lo) g_alarm = 1;
  else g_alarm = 0;

  /* 蜂鸣器: 高报/超量程且允许时响铃, 等级变化或每2s重复一次 */
  { static int  prev = -1;
    static uint32_t tlast = 0;
    if (g_alarm >= 2 && PP.buzzer_en) {
      uint32_t t = HAL_GetTick();
      if (g_alarm != prev || (t - tlast) >= 2000u) { tjc_beep(); tlast = t; }
    }
    prev = g_alarm;
  }

  /* 实时波形: 历史页曲线视图且有新数据时, 追加一个波形点 */
  if (g_page == 2 && g_view == 0 && sensor_has_new()) {
    tjc_wave_add(0, (uint8_t)(g_ppm * 255.0f / SENSOR_FS_PPM));
  }

  /* 每 HIST_PERIOD_MS 写入一条历史记录到 W25Q16 */
  { static uint32_t hist_last = 0;
    uint32_t hn = HAL_GetTick();
    if (hn - hist_last >= HIST_PERIOD_MS) { hist_last = hn; history_log((uint16_t)g_ppm); }
  }

  /* 主页对象整批刷新: 浓度/峰值/平均/状态/色条/统计 */
  {
    /* 主页: 浓度、峰值按单位换算(ppm 或 g/y) */
    if (PP.unit_mode == 1) {
      tjc_set_val(OBJ_CONC, (int)(g_ppm * GY_PER_PPM));
      tjc_set_val(OBJ_PEAK, (int)(g_peak * GY_PER_PPM));
      snprintf(g_avg_str, sizeof(g_avg_str), "%.2f", g_avg_run * GY_PER_PPM);
    } else {
      tjc_set_val(OBJ_CONC, (int)(g_ppm));
      tjc_set_val(OBJ_PEAK, (int)(g_peak));
      snprintf(g_avg_str, sizeof(g_avg_str), "%.2f", g_avg_run);
    }
    /* 流量占位(无流量传感器, 占位显示 "--") */
    tjc_set_txt(OBJ_FLOW,      "\xB5\xB1\xC7\xB0\xC1\xF7\xC1\xBF  --");
    /* 环境温度/湿度无传感器, 已移除显示 */

    /* 浓度最大值/最小值文本(按单位换算; 谷值哨兵则置0) */
    { float mx = PP.unit_mode ? (g_peak * GY_PER_PPM) : g_peak;
      float mn = (g_min > 1e6f) ? 0.0f : (PP.unit_mode ? (g_min * GY_PER_PPM) : g_min);
      snprintf(buf, sizeof(buf), "\xC5\xA8\xB6\xC8\xD7\xEE\xB4\xF3\xD6\xB5  %.0f", (double)mx); tjc_set_txt(OBJ_CONC_MAX, buf);
      snprintf(buf, sizeof(buf), "\xC5\xA8\xB6\xC8\xD7\xEE\xD0\xA1\xD6\xB5  %.0f", (double)mn); tjc_set_txt(OBJ_CONC_MIN, buf); }
    /* 当前阈值文本: "阈值  高/低" */
    snprintf(buf, sizeof(buf), "\xE3\xD0\xD6\xB5  \xB8\xDF%d/\xB5\xCD%d", g_thr_hi, g_thr_lo); tjc_set_txt(OBJ_THR_CUR, buf);
    /* 报警状态文本(含预热中) */
    switch (g_alarm) {
      case 0:  tjc_set_txt(OBJ_ALARM_TXT, g_warm ? "\xD7\xB4\xCC\xAC \xD4\xA4\xC8\xC8\xD6\xD0" : "\xD7\xB4\xCC\xAC \xD5\xFD\xB3\xA3");   break;

      case 1:  tjc_set_txt(OBJ_ALARM_TXT, "\xD7\xB4\xCC\xAC \xB5\xCD\xB1\xA8");   break;
      case 2:  tjc_set_txt(OBJ_ALARM_TXT, "\xD7\xB4\xCC\xAC \xB8\xDF\xB1\xA8");   break;
      case 3:  tjc_set_txt(OBJ_ALARM_TXT, "\xD7\xB4\xCC\xAC \xB3\xAC\xC1\xBF\xB3\xCC"); break;
    }
    tjc_set_txt(OBJ_BADGE_AVG, g_avg_str);
    /* 状态色条按报警等级着色 */
    switch (g_alarm) {
      case 3:
      case 2: tjc_set_pco(OBJ_STRIP, C_STRIP_RED);    break;
      case 1: tjc_set_pco(OBJ_STRIP, C_STRIP_ORANGE); break;
      default: tjc_set_pco(OBJ_STRIP, C_STRIP_GREEN);  break;
    }
    hmi_update_status_chips();   /* 刷新探头/泵/电池状态圆点 */
  }
}

/* ---------- 历史页视图切换 ---------- */
/* 按当前视图(曲线/数据表)显隐对应控件 */
static void apply_view(void) {
  static const char *curve_obj[] = {
    OBJ_CT_PL, OBJ_CT_TITLE, OBJ_CT_WAVE, OBJ_CT_LEG, OBJ_CT_ALARM,
    "cys0", "cys1", "cys2", "cys3", "cys4",
    OBJ_CT_PR, "stt", "mxl", "mx", "avl", "av", "mnl", "mn", "dul", "du", "ctl", "ct", "ex"
  };
  static const char *tbl_obj[] = {
    OBJ_TBL_PANEL, OBJ_TBL_HEAD_T, OBJ_TBL_HEAD_P,
    "tt0","tt1","tt2","tt3","tt4","tt5","tt6","tt7","tt8","tt9","tt10","tt11",
    "np0","np1","np2","np3","np4","np5","np6","np7","np8","np9","np10","np11",
    "bup", "bdn", OBJ_TBL_PAGE
  };
  unsigned i;
  int cvis = (g_view == 0) ? 1 : 0;   /* 曲线视图时显示曲线控件 */
  int tvis = (!cvis);                  /* 否则显示数据表控件 */
  for (i = 0; i < sizeof(curve_obj)/sizeof(curve_obj[0]); i++) tjc_vis(curve_obj[i], (uint8_t)cvis);
  for (i = 0; i < sizeof(tbl_obj)/sizeof(tbl_obj[0]);  i++) tjc_vis(tbl_obj[i],   (uint8_t)tvis);
}

/* 曲线重绘: 进入历史页时, 取末尾最多 WAVE_PTS 点还原波形并统计 */
static void refill_curve(void) {
  hist_rec_t rec;
  uint32_t avail = history_available();
  uint32_t n, i;
  char sbuf[24];
  uint16_t vmax = 0, vmin = 0xFFFF, cnt = 0;
  uint32_t sum = 0;

  n = (avail > WAVE_PTS) ? WAVE_PTS : avail;   /* 可绘点数: 取历史数与上限的较小者 */
  tjc_wave_cls(0);
  for (i = 0; i < n; i++) {
    /* 依次读取末尾 n 条记录(从偏移 avail-n 开始) */
    if (!history_read_one(avail - n + i, &rec)) break;
    if (rec.ppm > vmax) vmax = rec.ppm;        /* 统计最大值 */
    if (rec.ppm < vmin) vmin = rec.ppm;        /* 统计最小值 */
    sum += rec.ppm; cnt++;                     /* 累计求和与点数 */
    tjc_wave_add(0, (uint8_t)(rec.ppm * 255u / (uint16_t)SENSOR_FS_PPM));  /* 归一化到波形控件 */
  }
  if (cnt == 0) vmin = 0;
  /* 下发统计文本: 最大值/平均值/最小值/时长/点数 */
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)(cnt ? vmax : 0)); tjc_set_txt(OBJ_STAT_MAX, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%.1f", (double)(cnt ? ((float)sum / (float)cnt) : 0.0f)); tjc_set_txt(OBJ_STAT_AVG, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)vmin);       tjc_set_txt(OBJ_STAT_MIN, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)n);           tjc_set_txt(OBJ_STAT_DUR, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)n);           tjc_set_txt(OBJ_STAT_CNT, sbuf);
}

/* 历史统计下发(最大/平均/最小/时长/点数): 曲线页与数据表页共用 */
static void send_hist_stats(void) {
  hist_rec_t rec;
  uint32_t avail = history_available();
  uint32_t n = (avail > WAVE_PTS) ? WAVE_PTS : avail;
  uint32_t i;
  char sbuf[24];
  uint16_t vmax = 0, vmin = 0xFFFF, cnt = 0;
  uint32_t sum = 0;
  for (i = 0; i < n; i++) {
    if (!history_read_one(avail - n + i, &rec)) break;
    if (rec.ppm > vmax) vmax = rec.ppm;
    if (rec.ppm < vmin) vmin = rec.ppm;
    sum += rec.ppm; cnt++;
  }
  if (cnt == 0) vmin = 0;
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)(cnt ? vmax : 0)); tjc_set_txt(OBJ_STAT_MAX, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%.1f", (double)(cnt ? ((float)sum / (float)cnt) : 0.0f)); tjc_set_txt(OBJ_STAT_AVG, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)vmin);       tjc_set_txt(OBJ_STAT_MIN, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)n);           tjc_set_txt(OBJ_STAT_DUR, sbuf);
  snprintf(sbuf, sizeof(sbuf), "%u", (unsigned)n);           tjc_set_txt(OBJ_STAT_CNT, sbuf);
}

/* 数据表填充: 按当前页读取 HIST_TBL_ROWS 条历史, 填充时间/浓度/页号 */
static void refill_table(void) {
  hist_rec_t r[HIST_TBL_ROWS];
  uint16_t n, i;
  uint16_t pc, page = g_tbl_page;
  char s[40];

  pc = history_page_count(HIST_TBL_ROWS);   /* 总页数 */
  if (page < 1) page = 1;                   /* 页号钳位 */
  if (page > pc) page = pc;
  g_tbl_page = page;
  n = history_read_page(page, r, HIST_TBL_ROWS);

  for (i = 0; i < HIST_TBL_ROWS; i++) {
    char tObj[8], pObj[8];
    char tbuf[12], vbuf[12];
    if (i < n) {
      /* 时间: 取当日 时:分:秒 (秒相对本页起点) */
      unsigned hh = (r[i].ts / 3600u) % 24u, mm = (r[i].ts / 60u) % 60u, ss = r[i].ts % 60u;
      snprintf(tbuf, sizeof(tbuf), "%02u:%02u:%02u", hh, mm, ss);
      /* 浓度按单位换算显示 */
      if (PP.unit_mode == 1)
        snprintf(vbuf, sizeof(vbuf), "%.1f", (double)r[i].ppm * GY_PER_PPM);
      else
        snprintf(vbuf, sizeof(vbuf), "%u", (unsigned)r[i].ppm);
    } else {
      snprintf(tbuf, sizeof(tbuf), " ");    /* 空行占位 */
      snprintf(vbuf, sizeof(vbuf), " ");
    }
    snprintf(tObj, sizeof(tObj), "%s%u", OBJ_TBL_TIME_BASE, i);   /* 时间控件名(带索引拼接) */
    tjc_set_txt(tObj, tbuf);
    snprintf(pObj, sizeof(pObj), "%s%u", OBJ_TBL_PPM_BASE, i);    /* 浓度控件名(带索引拼接) */
    tjc_set_txt(pObj, vbuf);
  }
      snprintf(s, sizeof(s), "%u/%u", (unsigned)page, (unsigned)pc);   /* 页号文本 "当前/总页" */
  tjc_set_txt(OBJ_TBL_PAGE, s);
  send_hist_stats();
}


/* 峰值复位: 清空峰值与谷值并刷新屏 */
void hmi_on_peak_reset(void) { g_peak = 0.0f; g_min = 4294967.0f; tjc_set_val(OBJ_PEAK, 0); }

/* 阈值镜像: 屏端±按钮仅发命令码, MCU 为权威源计算+钳位+落盘+回写 */
static void thr_commit(void){ g_thr_hi=PP.thr_hi; g_thr_lo=PP.thr_lo; g_thr_dirty=1; g_save_pending=1; g_thr_dirty_t=HAL_GetTick(); }
void hmi_on_thr_hi_inc(void){ int v=(int)PP.thr_hi+50; if(v>1000)v=1000; PP.thr_hi=(uint16_t)v; thr_commit(); }
void hmi_on_thr_hi_dec(void){ int v=(int)PP.thr_hi-50; if(v<100) v=100; PP.thr_hi=(uint16_t)v; thr_commit(); }
void hmi_on_thr_lo_inc(void){ int v=(int)PP.thr_lo+10; if(v>1000)v=1000; PP.thr_lo=(uint16_t)v; thr_commit(); }
void hmi_on_thr_lo_dec(void){ int v=(int)PP.thr_lo-10; if(v<10)  v=10;   PP.thr_lo=(uint16_t)v; thr_commit(); }

/* 单位切换: ppm <-> g/y, 切换后同步单位 UI 并保存参数 */
void hmi_on_unit_toggle(void) {
  PP.unit_mode = !PP.unit_mode;            /* 0=ppm 1=g/y */
    app_apply_unit();  /* 同步单位: 刷新按钮文字与主页副标题 */

  /* 重新喂狗(任一操作周期都会喂狗) */
  iwdg_enable();
  iwdg_feed();
param_save(&PP);                            /* 保存单位到 flash */
  /* 屏端按钮(u)切换后, 回写按钮标签与当前单位一致 */
  tjc_set_txt(OBJ_UNIT_BTN, PP.unit_mode ? "g/\xC4\xEA" : "ppm");
}

/* 蜂鸣器开关: 切换并使能状态持久化 */
void hmi_on_buz_toggle(void) {
  PP.buzzer_en = !PP.buzzer_en; param_save(&PP);
  tjc_set_txt(OBJ_BUZ_BTN, PP.buzzer_en ? "\xBF\xAA" : "\xB9\xD8");   /* 回刷 bb 按钮 开/关 */
}

/* 泵启/停切换: 反转泵状态, 重新泵时清空峰值/谷值统计, 并刷圆点 */
void hmi_on_pump_toggle(void) {
  pump_toggle();               /* 反转泵启/停 */
  if (pump_get()) {            /* 泵重新启动时, 清除峰值/谷值统计 */
    g_peak = 0.0f; g_min = 4294967.0f;
  }
  hmi_update_status_chips();   /* 刷新各页状态圆点 */
}

/* 零点标定: 在洁净空气条件下, 令当前原始浓度对应 0ppm */
void hmi_on_cal_zero(void) {
  float ppm = sensor_read_ppm();
  if (ppm >= ZERO_CAL_THRESHOLD_PPM) { tjc_set_txt(OBJ_CAL0_BTN, "\xCA\xA7\xB0\xDC"); return; }   /* 失败: 当前浓度超阈值, 拒绝标定 */
  float raw = sensor_read_raw();
  int32_t k, b; sensor_get_cal(&k, &b);
  PP.cal_k = k;                        /* 保留原斜率 */
  PP.cal_b = (int32_t)(-raw);          /* 偏移 = -当前原始值, 使标定后当前值≈0ppm */
  PP.cal_valid = 1;
  param_save(&PP);
  sensor_set_cal(PP.cal_k, PP.cal_b);
  tjc_set_txt(OBJ_CAL0_BTN, "\xD6\xB4\xD0\xD0");
}

/* 量程标定: 在通已知浓度 SENSOR_SPAN_PPM 时标定, 计算并保存斜率 */
void hmi_on_cal_span(void) {
  float ppm = sensor_read_ppm();
  float lo = SENSOR_SPAN_PPM*0.9f, hi = SENSOR_SPAN_PPM*1.1f;
  if (ppm < lo || ppm > hi) { tjc_set_txt(OBJ_CAL1_BTN, "\xCA\xA7\xB0\xDC"); return; }   /* 失败: 标定时浓度须在标气浓度±10%内 */
  float raw = sensor_read_raw();
  int64_t m;
  if (raw <= 0.0f) return;               /* 原始值无效, 不执行 */
  m = (int64_t)(SENSOR_SPAN_PPM - PP.cal_b) * 1000 / (int64_t)raw;
  if (m < SENSOR_CAL_K_MIN) m = SENSOR_CAL_K_MIN;   /* 斜率钳位防越界 */
  if (m > SENSOR_CAL_K_MAX) m = SENSOR_CAL_K_MAX;
  PP.cal_k = (int32_t)m;
  PP.cal_valid = 1;
  param_save(&PP);
  sensor_set_cal(PP.cal_k, PP.cal_b);
  tjc_set_txt(OBJ_CAL1_BTN, "\xD6\xB4\xD0\xD0");
}

/* 恢复出厂: 恢复默认参数(标定/阈值/单位)并立即重启 */
void hmi_on_cal_factory(void) {
  param_factory(&PP, 1);            /* 恢复默认参数 */
  g_thr_hi = PP.thr_hi; g_thr_lo = PP.thr_lo;
  sensor_set_cal(PP.cal_k, PP.cal_b);
  app_apply_threshold(); app_apply_unit();
  HAL_Delay(120);          /* 留时间让屏显示恢复提示 */
  NVIC_SystemReset();      /* 恢复后立即重启 */

  /* (恢复出厂后直接复位, 后续不会执行) */
  iwdg_enable();
  iwdg_feed();
}



/* 历史视图切换(0=曲线/1=数据表): 切换显示并刷新对应内容 */
void hmi_on_view(int v) {
  g_view = (v != 0) ? 1 : 0;
  g_tbl_page = 1;
  apply_view();
  if (g_view) refill_table(); else refill_curve();   /* 按视图填充 */
}

/* 数据表翻页(±1): 页号钳位后刷新 */
void hmi_on_tbl_page(int delta) {
  uint16_t pc = history_page_count(HIST_TBL_ROWS);
  int np = (int)g_tbl_page + delta;
  if (np < 1) np = 1;
  if ((uint16_t)np > pc) np = (int)pc;
  g_tbl_page = (uint16_t)np;
  refill_table();
}

/* 页面切换回调: 记录当前页, 并按页同步参数显示 */
void hmi_on_page_enter(int p) {
  g_page = p;
  app_apply_unit();  /* 切页时刷新单位文本(按钮+副标题), 避免被屏端覆盖 */

  /* 喂狗(周期操作) */
  iwdg_enable();
  iwdg_feed();
  if (p == 1) {              /* 进入设置页: 以 MCU 配置回显阈值与蜂鸣器开关 */
    app_apply_threshold();
    tjc_set_txt(OBJ_BUZ_BTN, PP.buzzer_en ? "\xBF\xAA" : "\xB9\xD8");
  }

  if (p == 2) {              /* 进入历史页: 默认显示曲线视图 */
    g_view = 0;
    g_tbl_page = 1;
    apply_view();
    refill_curve();
  }
}

void hmi_on_export(void) {
  /* 历史导出: 当前无数据存储介质(SD卡未预留), 此处占位 */
  (void)0;
}

