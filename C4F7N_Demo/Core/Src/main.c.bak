/* ---- 从屏端 RTC 同步时间 (方案A: MCU 读取屏显示时间并本地计时) ---- */
static volatile uint8_t  g_time_sync_idx = 6;  /* 同步进度: 6=空闲/完成; 0..5 对应待读取的 rtcN */
static volatile uint32_t g_sync_rtc[6];        /* 依次缓存的 rtc0..rtc5 读取值 */
static volatile uint32_t g_wall_epoch = 0;     /* 同步完成的基准 epoch 秒 */
static volatile uint32_t g_wall_tick  = 0;     /* 同步时刻的 HAL_GetTick() */
static volatile uint32_t g_time_sync_deadline = 0; /* 同步超时截止 tick */
static volatile uint8_t  g_rtc_wait = 0;       /* 正在等待当前 rtcN 的 get 应答 */
static uint32_t rtc_to_epoch(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s);
static void rtc_time_start_sync(void);
static void rtc_time_finalize(void);
static void rtc_time_sync_poll(void);
uint32_t rtc_wall_seconds(void);

/* ---- IWDG 看门狗 前向声明 ---- */
static void iwdg_enable(void);  static void iwdg_feed(void);

/* ---- 屏端串口接收回调: 区分 get 应答与 printh 单字节命令 ---- */
/* 说明: 每收到 1 字节, 先交给 hmi_get_feed 判断是否为 get 应答帧(0x70/0x71 帧头),
 *   若是则以整帧解析(阈值/状态); 否则视为 printh 命令单字节, 转 hmi_on_rx_byte 分发 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  if (huart != NULL && huart->Instance != USART3) return;   /* 仅处理串口屏串口 */
  if (hmi_get_feed(rx_byte)) {
    /* 一帧 get 应答已收齐, 解析并应用(阈值/标定值/状态等) */
    hmi_get_response();
  } else {
    /* 非应答帧: 单字节命令码, 分发给对应处理函数 */
    hmi_on_rx_byte(rx_byte);
  }
  /* 每次回调后需重新使能下一次单字节接收 */
  HAL_UART_Receive_IT(huart, &rx_byte, 1);
}

/* 处理一帧完整的 get 应答: 判断是 RTC 同步还是阈值返回值 */
void hmi_get_response(void) {
  uint32_t v = hmi_get_value();
  if (g_time_sync_idx < 6u && g_rtc_wait) {   /* 本次应答属于 RTC 同步(取 rtcN) */
    g_sync_rtc[g_time_sync_idx] = v;
    g_time_sync_idx++;
    g_rtc_wait = 0;
    if (g_time_sync_idx >= 6u) {              /* 6 个时间分量收齐, 合成 epoch */
      g_wall_epoch = rtc_to_epoch(g_sync_rtc[0], g_sync_rtc[1], g_sync_rtc[2], g_sync_rtc[3], g_sync_rtc[4], g_sync_rtc[5]);
      g_wall_tick = HAL_GetTick();
    }
    return;
  }


}


/* 将当前存储的阈值下发到屏端对象 h/l 及面板状态栏, 保证屏显与实际一致 */
static void app_apply_threshold(void) {
  g_thr_hi = PP.thr_hi; g_thr_lo = PP.thr_lo;
  tjc_set_val(OBJ_THR_HI_VAL, g_thr_hi);
  tjc_set_val(OBJ_THR_LO_VAL, g_thr_lo);
  /* 面板阈值状态栏文本: "阈值  高/低" */
  {
    char b[32];
    snprintf(b, sizeof(b), "\xE3\xD0\xD6\xB5  %d/%d", g_thr_hi, g_thr_lo);
    tjc_set_txt(OBJ_THR_CUR, b);
  }
}
/* 按当前单位刷新屏端单位: 单位按钮文字 + 主页副标题 */
static void app_apply_unit(void) {
  tjc_set_txt(OBJ_UNIT_BTN, PP.unit_mode ? "g/\xC4\xEA" : "ppm");
  /* 主页副标题等随单位切换刷新 */
  tjc_set_txt(OBJ_CONC_SUB, PP.unit_mode ? "g/\xC4\xEA \xD0\xB9\xC2\xA9" : "ppm \xC5\xA8\xB6\xC8\xCA\xB5\xCA\xB1\xD6\xB5");
}

/* ---------- 软件看门狗: 约4s未喂狗则强制复位 ---------- */
static uint32_t g_iwdg_t = 0;
static uint8_t  g_iwdg_on = 0;
static void iwdg_enable(void) { g_iwdg_on = 1; g_iwdg_t = HAL_GetTick(); }
static void iwdg_feed(void) {
  if (g_iwdg_on && (HAL_GetTick() - g_iwdg_t) > 4000u) NVIC_SystemReset();  /* 超时未喂狗 -> 复位 */
  g_iwdg_t = HAL_GetTick();
}

/* ---------- 屏端 RTC 时间换算为 epoch ---------- */
uint32_t rtc_wall_seconds(void) {
  return g_wall_epoch + (uint32_t)((HAL_GetTick() - g_wall_tick) / 1000u);  /* 基准+已运行秒数 */
}
/* 将 年/月/日/时/分/秒 转换为自纪元起的秒数 */
static uint32_t rtc_to_epoch(uint32_t y, uint32_t mo, uint32_t d, uint32_t h, uint32_t mi, uint32_t s) {
  int yy = (int)y, mm = (int)mo;
  yy -= (mm <= 2);
  int era = (yy >= 0 ? yy : yy - 399) / 400;
  unsigned yoe = (unsigned)(yy - era * 400);
  unsigned month = (unsigned)(mm + (mm > 2 ? -3 : 9));
  unsigned doy = (153u * month + 2u) / 5u + (unsigned)d - 1u;
  unsigned doe = yoe * 365u + yoe / 4u - yoe / 100u + doy;
  uint32_t days = (uint32_t)(era * 146097) + doe - 719468u;
  return days * 86400u + h * 3600u + mi * 60u + s;
}
/* 启动一次时间同步: 从 rtc0 开始依次 get */
static void rtc_time_start_sync(void) {
  g_time_sync_idx = 0; g_time_sync_deadline = HAL_GetTick() + 2000u; g_rtc_wait = 1;
  tjc_get("rtc0", "val");
}
static void rtc_time_finalize(void) {
  /* (预留) 时间分量收齐后的收尾: 标记同步完成 */
  g_time_sync_idx = 6; /* 同步完成 */
}
/* 周期轮询: 依次向屏端 get rtc0..rtc5, 直至全部完成或超时 */
static void rtc_time_sync_poll(void) {
  if (g_time_sync_idx >= 6u) return;                                    /* 已完成/空闲 */
  if (HAL_GetTick() > g_time_sync_deadline) { g_time_sync_idx = 6; g_rtc_wait = 0; return; }  /* 超时放弃 */
  if (!g_rtc_wait) { char o[8]; snprintf(o, sizeof(o), "rtc%u", (unsigned)g_time_sync_idx); g_rtc_wait = 1; tjc_get(o, "val"); } /* 发起下一个 rtcN 的 get */
}
